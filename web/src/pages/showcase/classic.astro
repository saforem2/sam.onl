---
import Layout from '@/layouts/Layout.astro'
import Intro from '@/components/landing/sections/IntroAlt.astro'
import RecentPosts from '@/components/landing/sections/RecentPosts.astro'
import RecentTalks from '@/components/landing/sections/RecentTalks.astro'
import WidgetShowcase from '@/components/landing/sections/WidgetShowcase.astro'
import VimNavigation from '@/components/landing/VimNavigation.astro'
---

<Layout>
    <main data-landing>
        <Intro />
        <RecentPosts />
        <RecentTalks />
        <WidgetShowcase />
    </main>
    <column id="statusline">
        <row>
            <span
                is-="badge"
                variant-="green"
                style="--badge-text: var(--background0)">NORMAL</span
            >
            <span
                is-="badge"
                variant-="background1"
                style="--badge-text: var(--green)">&#xe725; main</span
            >
            <row self-="grow">
                <span is-="badge" variant-="code-bg">samf.sh</span>
            </row>
            <row id="statusline-right">
                <span is-="badge" variant-="code-bg">utf-8</span>
                <span is-="badge" variant-="background1">Top</span>
                <span
                    is-="badge"
                    variant-="green"
                    style="--badge-text: var(--background0)">1:1</span
                >
            </row>
        </row>
    </column>
    <div id="vim-navigation-container">
        <VimNavigation />
    </div>
</Layout>

<style is:global>
    #vim-navigation-container {
        position: fixed;
        top: 1lh;
        right: 2ch;
    }

    #statusline {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 1lh;
        z-index: 100;
        overflow: hidden;
        background-color: var(--background1);
    }

    #statusline [is-~='badge'][variant-='background0'] {
        --badge-color: var(--mantle, var(--background1));
        --badge-text: var(--foreground1);
    }

    #statusline [is-~='badge'][variant-='background1'] {
        --badge-color: var(--crust, var(--background2));
        --badge-text: var(--foreground0);
    }

    @media (max-width: 50ch) {
        #statusline-right {
            display: none;
        }
    }

    main[data-landing] {
        height: 100vh;
        scroll-snap-type: y mandatory;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
        scrollbar-color: var(--foreground1) var(--background2);
        padding-bottom: 2lh;
    }

    main[data-landing] > section,
    main[data-landing] > header {
        scroll-snap-align: start;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overflow-x: clip;
    }

    main[data-landing] section .content {
        max-width: min(80ch, 100%);
        width: round(calc(100% - 2ch), 1ch);
        row-gap: 2ch;
        column-gap: 1lh;
    }
</style>
