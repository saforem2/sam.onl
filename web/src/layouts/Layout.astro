---
import '@/styles/global.css'

interface Props {
    ogSlug?: string
    description?: string
    title?: string
}

const { ogSlug, description, title } = Astro.props as Props
const pageDescription = description || "Sam Foreman's Personal Website"
const pageTitle = title || 'Sam Foreman'
const ogImage = ogSlug
    ? `https://sam.onl/og/${ogSlug}.png`
    : 'https://sam.onl/social-card.png'
---

<!doctype html>
<html lang="en" data-webtui-theme="custom-light">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <!-- Google Analytics -->
        <script
            is:inline
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-RD883HJ1J2"
        ></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || []
            function gtag(...args) {
                dataLayer.push(args)
            }
            gtag('js', new Date())
            gtag('config', 'G-RD883HJ1J2')
        </script>

        <link rel="preconnect" href="https://cdn.jsdelivr.net" />
        <script is:inline>
            const storedTheme = localStorage.getItem('webtui-theme')
            const migratedTheme =
                storedTheme === 'light'
                    ? 'custom-light'
                    : storedTheme === 'dark'
                      ? 'custom-dark'
                      : storedTheme
            const systemTheme = window.matchMedia(
                '(prefers-color-scheme: dark)',
            ).matches
                ? 'custom-dark'
                : 'custom-light'
            const resolvedTheme = migratedTheme ?? systemTheme
            document.documentElement.setAttribute(
                'data-webtui-theme',
                resolvedTheme,
            )
            if (migratedTheme && migratedTheme !== storedTheme) {
                localStorage.setItem('webtui-theme', migratedTheme)
            }

            // Mono-font preference (default: iosevka)
            const storedMono = localStorage.getItem('mono-font') ?? 'iosevka'
            document.documentElement.setAttribute('data-mono-font', storedMono)
        </script>
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>

        <!-- Icon(s) -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" href="/logo@512.png" />

        <!-- OpenGraph / X Title -->
        <meta property="og:title" content={pageTitle} />
        <meta name="twitter:title" content={pageTitle} />

        <!-- OpenGraph / X Description -->
        <meta name="description" content={pageDescription} />
        <meta name="og:description" content={pageDescription} />
        <meta name="twitter:description" content={pageDescription} />

        <!-- OpenGraph / X Cover Image -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImage} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={ogSlug ? '1200' : '2400'} />
        <meta property="og:image:height" content={ogSlug ? '630' : '1260'} />
        <meta
            property="og:image:alt"
            content="Sam Foreman social card with terminal-style branding and AI/HPC focus"
        />
        <meta
            name="twitter:image:alt"
            content="Sam Foreman social card with terminal-style branding and AI/HPC focus"
        />

        <!-- Misc Metadata -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://sam.onl" />
        <meta name="twitter:site" content="@saforem2" />
        <meta name="twitter:creator" content="@saforem2" />
        <meta name="twitter:url" content="https://sam.onl" />
        <meta
            name="keywords"
            content="blog,machine learning,deep learning,artificial intelligence,supercomputing,programming,technology,sam foreman"
        />
        <meta name="theme-color" content="#1c1c1c" />

        <!-- Fonts -->
        <link
            rel="preconnect"
            href="https://iosevka-webfonts.github.io"
            crossorigin
        />
        <link
            rel="preload"
            href="https://iosevka-webfonts.github.io/iosevka/Iosevka.css"
            as="style"
        />
        <link
            href="https://iosevka-webfonts.github.io/iosevka/Iosevka.css"
            rel="stylesheet"
        />
        <style is:inline>
            svg[id^='mermaid-'] {
                display: block;
                width: 100%;
                max-width: 100%;
                height: auto !important;
                min-height: 0;
            }
            svg[id^='mermaid-'] foreignObject * {
                margin: 0 !important;
                padding: 0 !important;
                line-height: normal !important;
            }
            .mermaid.mermaid-interactive {
                background-color: var(--background0);
                border: 1px solid var(--background2);
                /* Breathing room above and below the figure so it doesn't
                   crowd the surrounding text. */
                margin-block: 1lh;
            }
            .mermaid.mermaid-interactive:focus-visible {
                outline: 1px solid var(--blue);
                outline-offset: -1px;
            }
            .mermaid-viewport {
                position: relative;
                overflow: hidden;
                width: 100%;
            }
            .mermaid-controls {
                position: absolute;
                bottom: 1ch;
                right: 1ch;
                display: flex;
                flex-direction: column;
                gap: 1ch;
                padding: 1ch;
                background-color: var(--background1);
                border: 1px solid var(--background2);
                z-index: 1;
                user-select: none;
                opacity: 0;
                transition: opacity 0.15s ease-out;
            }
            .mermaid-viewport:hover .mermaid-controls,
            .mermaid-viewport:focus-within .mermaid-controls {
                opacity: 1;
            }
            .mermaid-pad {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                grid-template-rows: repeat(3, 1fr);
                gap: 0;
            }
            .mermaid-pad .mc-up {
                grid-column: 2;
                grid-row: 1;
            }
            .mermaid-pad .mc-left {
                grid-column: 1;
                grid-row: 2;
            }
            .mermaid-pad .mc-reset {
                grid-column: 2;
                grid-row: 2;
            }
            .mermaid-pad .mc-right {
                grid-column: 3;
                grid-row: 2;
            }
            .mermaid-pad .mc-down {
                grid-column: 2;
                grid-row: 3;
            }
            .mermaid-zoom {
                display: flex;
                gap: 0;
                justify-content: center;
            }
            .mermaid-ctrl {
                appearance: none;
                background: var(--background2);
                color: var(--foreground1);
                border: none;
                width: 2ch;
                height: 1lh;
                font-family: inherit;
                font-size: 0.85em;
                line-height: 1;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0;
            }
            .mermaid-ctrl:hover {
                background: var(--blue);
                color: var(--background0);
            }
            .mermaid-ctrl:focus-visible {
                outline: 1px solid var(--blue);
                outline-offset: -1px;
            }
            .mermaid-ctrl.mc-reset:hover {
                background: var(--orange);
            }
            .mermaid-ctrl.mc-success {
                background: var(--green);
                color: var(--background0);
            }
            .mermaid-actions {
                position: absolute;
                top: 1ch;
                right: 1ch;
                display: flex;
                gap: 0;
                z-index: 1;
                user-select: none;
                opacity: 0;
                transition: opacity 0.15s ease-out;
            }
            .mermaid-viewport:hover .mermaid-actions,
            .mermaid-viewport:focus-within .mermaid-actions {
                opacity: 1;
            }
            .mermaid-actions .mermaid-ctrl {
                width: 3ch;
                background: var(--background1);
                border: 1px solid var(--background2);
            }
            .mermaid-actions .mermaid-ctrl + .mermaid-ctrl {
                border-left: none;
            }
            .mermaid-modal {
                position: fixed;
                inset: 0;
                background-color: oklch(from var(--background0) l c h / 0.85);
                z-index: 1000;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 2lh 2ch;
            }
            .mermaid-modal-inner {
                position: relative;
                width: 100%;
                height: 100%;
                background-color: var(--background0);
                border: 1px solid var(--background2);
                padding: 2lh 2ch 1lh;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: auto;
            }
            .mermaid-modal-inner svg {
                display: block !important;
                max-width: 100% !important;
                max-height: 100% !important;
                width: auto !important;
                height: auto !important;
            }
            .mermaid-modal-close {
                position: absolute;
                top: 1ch;
                right: 1ch;
                appearance: none;
                background: var(--background1);
                color: var(--foreground1);
                border: 1px solid var(--background2);
                width: 3ch;
                height: 1lh;
                font-family: inherit;
                font-size: 0.95em;
                line-height: 1;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0;
            }
            .mermaid-modal-close::before {
                content: '\f00d';
            }
            .mermaid-modal-close:hover {
                background: var(--red);
                color: var(--background0);
            }
        </style>
        <script is:inline>
            const normalizeMermaidSvgSize = () => {
                const mermaidSvgs = document.querySelectorAll(
                    "svg[id^='mermaid-']",
                )

                mermaidSvgs.forEach((node) => {
                    const viewBox = node.getAttribute('viewBox')
                    if (!viewBox) return

                    const parts = viewBox
                        .trim()
                        .split(/\s+/)
                        .map((value) => Number(value))
                    if (parts.length !== 4) return

                    const width = parts[2]
                    const height = parts[3]
                    if (!Number.isFinite(width) || !Number.isFinite(height))
                        return
                    if (width <= 0 || height <= 0) return

                    // Set explicit aspect ratio and let CSS handle sizing
                    node.style.setProperty(
                        'aspect-ratio',
                        `${width} / ${height}`,
                        'important',
                    )
                    node.style.setProperty('width', '100%', 'important')
                    node.style.setProperty('max-width', '100%', 'important')
                    node.style.setProperty('height', 'auto', 'important')
                    node.style.setProperty('display', 'block', 'important')
                })
            }

            if (document.readyState === 'loading') {
                document.addEventListener(
                    'DOMContentLoaded',
                    normalizeMermaidSvgSize,
                    {
                        once: true,
                    },
                )
            } else {
                normalizeMermaidSvgSize()
            }

            window.addEventListener('load', normalizeMermaidSvgSize, {
                once: true,
            })
            setTimeout(normalizeMermaidSvgSize, 0)
            setTimeout(normalizeMermaidSvgSize, 50)
            setTimeout(normalizeMermaidSvgSize, 250)
        </script>
        <!-- <link rel="preconnect" href="https://fonts.googleapis.com" /> -->
        <!-- <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /> -->
        <!-- <link -->
        <!--     href="https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap" -->
        <!--     rel="stylesheet" -->
        <!-- /> -->
        <!-- <link -->
        <!--     href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400..600;1,400..600&display=swap" -->
        <!--     rel="stylesheet" -->
        <!-- /> -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebSite',
                name: 'Sam Foreman',
                url: 'https://sam.onl',
                author: {
                    '@type': 'Person',
                    name: 'Sam Foreman',
                    jobTitle: 'Computational Scientist',
                    affiliation: {
                        '@type': 'Organization',
                        name: 'Argonne National Laboratory',
                    },
                    url: 'https://sam.onl',
                },
            })}
        />
    </head>
    <body>
        <slot />
        <script type="module">
            const MAIN_FOCUS_SELECTOR = '#main-content, main, [role="main"]'

            const isNaturallyFocusable = (element) =>
                element.matches(
                    'a[href], button, input, textarea, select, summary, [tabindex]:not([tabindex="-1"])',
                )

            const focusMainRegion = () => {
                if (window.location.hash.length > 0) return

                const mainRegion = document.querySelector(MAIN_FOCUS_SELECTOR)
                if (!(mainRegion instanceof HTMLElement)) return

                const firstMainChild = mainRegion.firstElementChild
                const target =
                    firstMainChild instanceof HTMLElement
                        ? firstMainChild
                        : mainRegion

                const activeElement = document.activeElement
                if (
                    activeElement instanceof HTMLElement &&
                    activeElement !== document.body &&
                    activeElement !== document.documentElement
                ) {
                    return
                }

                if (!isNaturallyFocusable(target)) {
                    if (mainRegion.id === 'main-content') {
                        target.setAttribute('tabindex', '0')
                    } else {
                        target.setAttribute('tabindex', '-1')
                    }
                }

                target.focus({ preventScroll: true })
            }

            focusMainRegion()
        </script>
        <script>
            if (
                document.querySelector('.mermaid, pre[data-language="mermaid"]')
            ) {
                import('@/utils/mermaid-render').then(({ initMermaid }) =>
                    initMermaid(),
                )
            }
        </script>
    </body>
</html>
