---
import Sidebar from '@/components/Sidebar.astro'
import Layout from '@/layouts/Layout.astro'
import { makeSortedCategoryEntries } from '@/utils/content'
import { compareUrlPaths } from '@/utils/url'
import Navbar from '@/components/NavbarMinimal.astro'
import { getReadingTime } from '@/utils/readingTime'
import ShareButtons from '@/components/ShareButtons.astro'
import { getCollection } from 'astro:content'

type DocHeading = {
    depth: number
    text: string
    slug: string
}

type TocLine = DocHeading & {
    treePrefix: string
}

const { frontmatter, headings } = Astro.props as {
    frontmatter: { title: string; date?: string; description?: string }
    headings: DocHeading[]
}

const sortedPages = makeSortedCategoryEntries().flatMap(
    (category) => category[1],
)
const pageIndex = sortedPages.findIndex((page) =>
    compareUrlPaths(page.id, Astro.url.pathname),
)
const nextDoc =
    pageIndex === sortedPages.length - 1
        ? undefined
        : sortedPages.at(pageIndex + 1)
const prevDoc = pageIndex === 0 ? undefined : sortedPages.at(pageIndex - 1)

const tocHeadings: DocHeading[] = [
    { depth: 1, text: frontmatter.title, slug: 'toc-page-title' },
    ...headings.filter((heading) => heading.depth >= 2),
]

const hasSiblingAfter = (items: DocHeading[], index: number) => {
    const currentDepth = items[index].depth

    for (let nextIndex = index + 1; nextIndex < items.length; nextIndex += 1) {
        const nextDepth = items[nextIndex].depth

        if (nextDepth === currentDepth) return true
        if (nextDepth < currentDepth) return false
    }

    return false
}

const ancestorHasSibling = new Map<number, boolean>()
const tocLines: TocLine[] = tocHeadings.map((heading, index) => {
    const isLastSibling = !hasSiblingAfter(tocHeadings, index)

    let ancestorPrefix = ''
    for (let level = 2; level < heading.depth; level += 1) {
        ancestorPrefix += ancestorHasSibling.get(level) ? '│  ' : '   '
    }

    const branchPrefix =
        heading.depth === 1 ? '' : isLastSibling ? '└─ ' : '├─ '

    ancestorHasSibling.set(heading.depth, !isLastSibling)

    return {
        ...heading,
        treePrefix: `${ancestorPrefix}${branchPrefix}`,
    }
})

const rawBody = await Astro.slots.render('default')
const readingTime = getReadingTime(rawBody.replace(/<[^>]*>/g, ''))

// Find related posts (same parent directory)
const currentPath = Astro.url.pathname
const isPost = currentPath.startsWith('/posts/')
const isTalk = currentPath.startsWith('/talks/')

// Derive category from URL path (e.g. /posts/auroragpt/foo → "auroragpt")
const pathSegments = currentPath.split('/').filter(Boolean)
const category =
    pathSegments.length >= 3 && isNaN(Number(pathSegments[1]))
        ? pathSegments[1]
        : null

// Source file path for GitHub links
const sourceFile = sortedPages.find((p) => compareUrlPaths(p.id, currentPath))
const sourceId = sourceFile?.id ?? ''
// The collection id strips index.md(x) — reconstruct the full file path
const sourceFilePath = sourceFile
    ? sourceId.endsWith('.md') || sourceId.endsWith('.mdx')
        ? `web/src/pages/${sourceId}`
        : `web/src/pages/${sourceId}/index.mdx`
    : null
const githubBase = 'https://github.com/saforem2/sam.onl'
const githubRawBase = 'https://raw.githubusercontent.com/saforem2/sam.onl'

// Get file last-modified date
import { stat } from 'node:fs/promises'
let fileModifiedDate: Date | null = null
if (sourceFilePath) {
    try {
        const resolvedPath = new URL(
            `../${sourceFilePath.replace('web/', '')}`,
            import.meta.url,
        ).pathname
        const fileStat = await stat(resolvedPath)
        fileModifiedDate = fileStat.mtime
    } catch {
        // File not found, skip
    }
}

// Format date helper
function formatDate(d: string | Date): string {
    return new Date(d).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
    })
}

function formatDateShort(d: string | Date): string {
    const dt = new Date(d)
    const mm = String(dt.getMonth() + 1).padStart(2, '0')
    const dd = String(dt.getDate()).padStart(2, '0')
    const yy = String(dt.getFullYear()).slice(-2)
    return `${mm}/${dd}/${yy}`
}
let relatedPosts: Array<{ title: string; date: Date; href: string }> = []

if (isPost) {
    const allDocs = await getCollection('docs')
    const pathParts = currentPath.split('/').filter(Boolean)
    const parentDir =
        pathParts.length >= 3
            ? pathParts.slice(0, pathParts.length - 1).join('/')
            : 'posts'

    relatedPosts = allDocs
        .filter((doc) => {
            const docPath = doc.id.replace(/\/index\.(mdx?|md)$/, '')
            return (
                docPath.startsWith(parentDir) &&
                `/${docPath}` !== currentPath.replace(/\/$/, '') &&
                doc.data.title &&
                doc.data.date &&
                !doc.data.draft &&
                !doc.id.endsWith(`${parentDir}/index.mdx`)
            )
        })
        .map((doc) => ({
            title: doc.data.title,
            date: new Date(doc.data.date!),
            href: `/${doc.id.replace(/\/index\.(mdx?|md)$/, '/')}`,
        }))
        .sort((a, b) => b.date.getTime() - a.date.getTime())
        .slice(0, 3)
}

const articleSchema =
    isPost && frontmatter.date
        ? JSON.stringify({
              '@context': 'https://schema.org',
              '@type': 'Article',
              headline: frontmatter.title,
              datePublished: new Date(frontmatter.date).toISOString(),
              author: {
                  '@type': 'Person',
                  name: 'Sam Foreman',
                  url: 'https://sam.onl',
              },
              description: frontmatter.description ?? '',
          })
        : null
---

<style is:global>
    @import './Doc.css';
</style>

<Layout
    ogSlug={Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '')}
    title={frontmatter.title ? `${frontmatter.title} — Sam Foreman` : undefined}
    description={frontmatter.description}>
    {
        articleSchema && (
            <script type="application/ld+json" set:html={articleSchema} />
        )
    }
    <column self-="grow">
        <Navbar />
        <row self-="grow" gap-="1">
            <div id="sidebar-container" class="mobile-hidden">
                <Sidebar />
            </div>
            <div id="sidebar-resizer" aria-hidden="true"></div>
            <article id="doc-article" box-="square" shear-="top">
                <header>
                    <div is-="badge" variant-="background0">
                        <h1>{frontmatter.title}</h1>
                    </div>
                    {
                        (frontmatter.date || isPost || isTalk) && (
                            <div class="post-meta">
                                <div class="post-meta-row">
                                    <span
                                        is-="badge"
                                        variant-="background1"
                                        class="post-meta-item"
                                        tabindex="0">
                                        Sam Foreman
                                    </span>
                                    {frontmatter.date && (
                                        <span
                                            is-="badge"
                                            variant-="background1"
                                            class="post-meta-item"
                                            tabindex="0">
                                            <span class="date-long">
                                                {formatDate(frontmatter.date)}
                                            </span>
                                            <span class="date-short">
                                                {formatDateShort(
                                                    frontmatter.date,
                                                )}
                                            </span>
                                        </span>
                                    )}
                                    {fileModifiedDate &&
                                        frontmatter.date &&
                                        formatDate(fileModifiedDate) !==
                                            formatDate(frontmatter.date) && (
                                            <span
                                                is-="badge"
                                                variant-="background1"
                                                class="post-meta-item"
                                                tabindex="0">
                                                updated:{' '}
                                                <span class="date-long">
                                                    {formatDate(
                                                        fileModifiedDate,
                                                    )}
                                                </span>
                                                <span class="date-short">
                                                    {formatDateShort(
                                                        fileModifiedDate,
                                                    )}
                                                </span>
                                            </span>
                                        )}
                                    {frontmatter.date && (
                                        <span
                                            is-="badge"
                                            variant-="background1"
                                            class="post-meta-item"
                                            tabindex="0">
                                            {readingTime}
                                        </span>
                                    )}
                                    {category && (
                                        <a
                                            href={`/posts/${category}/`}
                                            is-="badge"
                                            variant-="background1"
                                            class="post-meta-tag"
                                            tabindex="0">
                                            {category}
                                        </a>
                                    )}
                                </div>
                                <div class="post-meta-row">
                                    {sourceFilePath && (
                                        <span class="post-meta-links">
                                            <a
                                                href={`${githubBase}/blob/main/${sourceFilePath}`}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                is-="badge"
                                                variant-="background2"
                                                tabindex="0">
                                                source
                                            </a>
                                            <a
                                                href={`${githubRawBase}/main/${sourceFilePath}`}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                is-="badge"
                                                variant-="background2"
                                                tabindex="0">
                                                raw
                                            </a>
                                        </span>
                                    )}
                                    {(isPost || isTalk) && (
                                        <ShareButtons
                                            title={frontmatter.title}
                                            url={`https://sam.onl${Astro.url.pathname}`}
                                        />
                                    )}
                                </div>
                            </div>
                        )
                    }
                </header>
                <row gap-="1" self-="grow">
                    <div id="scroll-progress" aria-hidden="true"></div>
                    <div id="scroll-container">
                        <main id="main-content">
                            <span
                                id="toc-page-title"
                                aria-hidden="true"
                                tabindex="-1"></span>
                            <slot />
                            {
                                relatedPosts.length > 0 && (
                                    <aside style="margin-top: 2lh; border-top: 1px solid var(--foreground2); padding-top: 1lh;">
                                        <h3>Related posts</h3>
                                        <ul style="list-style: none; padding: 0;">
                                            {relatedPosts.map((post) => (
                                                <li>
                                                    <a href={post.href}>
                                                        {post.title}
                                                    </a>
                                                    <span style="opacity: 0.6; font-size: 0.85em;">
                                                        {' '}
                                                        —{' '}
                                                        {post.date.toLocaleDateString(
                                                            'en-US',
                                                            {
                                                                year: 'numeric',
                                                                month: 'short',
                                                                day: 'numeric',
                                                            },
                                                        )}
                                                    </span>
                                                </li>
                                            ))}
                                        </ul>
                                    </aside>
                                )
                            }
                            <div id="doc-pagination">
                                {
                                    prevDoc && (
                                        <a
                                            href={`/${prevDoc.id}`}
                                            class="prev"
                                            box-="square"
                                            shear-="top"
                                            tabindex="0">
                                            <div is-="typography-block">
                                                <span
                                                    is-="badge"
                                                    variant-="background1">
                                                    <row gap-="1">
                                                        <span>←</span>
                                                        <span>
                                                            [<b>b</b>]ack
                                                        </span>
                                                    </row>
                                                </span>
                                            </div>
                                            <span pad-="1 0">
                                                {prevDoc.id.split('/')[0]}/
                                                {prevDoc.data.title}
                                            </span>
                                        </a>
                                    )
                                }
                                {
                                    nextDoc && (
                                        <a
                                            href={`/${nextDoc.id}`}
                                            class="next"
                                            box-="square"
                                            shear-="top"
                                            tabindex="0">
                                            <row
                                                align-="start end"
                                                is-="typography-block">
                                                <span
                                                    is-="badge"
                                                    variant-="background1">
                                                    <row gap-="1">
                                                        <span>
                                                            [<b>n</b>]ext
                                                        </span>
                                                        <span>→</span>
                                                    </row>
                                                </span>
                                            </row>
                                            <span pad-="1 0">
                                                {nextDoc.id.split('/')[0]}/
                                                {nextDoc.data.title}
                                            </span>
                                        </a>
                                    )
                                }
                            </div>
                        </main>
                    </div>
                </row>
            </article>
            {
                tocHeadings.length > 0 && (
                    <>
                        <div id="toc-resizer" aria-hidden="true" />
                        <aside
                            id="toc-container"
                            class="mobile-hidden collapsed">
                            <nav
                                box-="square"
                                shear-="top"
                                id="toc-sidebar"
                                aria-label="Table of contents">
                                <button
                                    id="toc-toggle"
                                    type="button"
                                    size-="small"
                                    aria-expanded="false"
                                    aria-controls="toc-container"
                                    aria-label="Collapse right sidebar (zl)">
                                    <>
                                        <span class="key-z">z</span>
                                        <span class="key-bracket">[</span>
                                    </>
                                    <>
                                        <span class="key-l">l</span>
                                        <span class="key-bracket">]</span>
                                    </>
                                    &rsaquo;
                                </button>
                                <div id="toc-list-container">
                                    <ul id="toc-list">
                                        {tocLines.map((heading) => (
                                            <li>
                                                <a
                                                    href={`#${heading.slug}`}
                                                    class={`toc-link depth-${heading.depth}`}
                                                    data-heading-slug={
                                                        heading.slug
                                                    }>
                                                    <span
                                                        class="toc-tree-prefix"
                                                        data-tree-prefix={
                                                            heading.treePrefix
                                                        }
                                                        aria-hidden="true"
                                                    />
                                                    <span>{heading.text}</span>
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            </nav>
                        </aside>
                    </>
                )
            }
        </row>
        <div id="vim-statusline">
            <span class="vsl-vim-icon">&#xe62b; </span>
            <span class="vsl-mode">NORMAL</span>
            <span class="vsl-branch">&#xe725; main</span>
            <span class="vsl-site">sam.onl</span>
            <span class="vsl-file"
                >{
                    sourceFilePath?.replace(
                        'web/src/pages/',
                        '',
                    ) ?? Astro.url.pathname
                }</span
            >
            <span class="vsl-spacer"></span>
            <span class="vsl-keys">
                <span id="vsl-last-key"></span>
                <button id="vsl-btn-j" tabindex="-1">j</button>
                <button id="vsl-btn-k" tabindex="-1">k</button>
                <button id="vsl-btn-q" tabindex="-1">?</button>
            </span>
            <span class="vsl-clock">&#xe382; <span id="vsl-clock-text"></span></span>
            <span class="vsl-pos">Top</span>
            <span class="vsl-loc">1:1</span>
        </div>
        <div id="mobile-nav">
            <button size-="small" variant-="background1" id="menu-button">
                &#xeb86; Menu
            </button>
            <button size-="small" id="docs-button">&#xf15b; Docs</button>
            {
                tocHeadings.length > 0 && (
                    <button
                        size-="small"
                        variant-="background1"
                        id="toc-button">
                        &#xf0c9; TOC
                    </button>
                )
            }
        </div>
    </column>
</Layout>

<!-- Vim Navigation -->
<script>
    import {
        applyVimNavigation,
        isUserTyping,
        vimFocusElement,
    } from '@/utils/vim'

    const mainItemQuery = '[tabindex="0"], a[href], summary'
    const queryString = `#main-content ${mainItemQuery}`
    const navbarQueryString =
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'

    const vimTabbableElements: NodeListOf<HTMLElement> =
        document.querySelectorAll(queryString)

    let currentElement: HTMLElement | null = null

    const findFirstFocusableElement = () =>
        Array.from(vimTabbableElements).find((el) => {
            const rect = el.getBoundingClientRect()

            return rect.top >= 0 && rect.bottom <= window.innerHeight
        })

    const mainContent = document.getElementById('main-content') as HTMLElement
    const navbar = document.getElementById('top-navbar') as HTMLElement | null
    const sidebar = document.getElementById('sidebar') as HTMLElement | null
    const tocSidebar = document.getElementById(
        'toc-sidebar',
    ) as HTMLElement | null
    const getNavbarTarget = () =>
        navbar?.querySelector(
            'a[data-active="true"], a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        )
    const getSidebarTarget = () =>
        sidebar?.querySelector('a.active') ||
        sidebar?.querySelector('details summary') ||
        sidebar?.querySelector('a')
    const getTocTarget = () =>
        tocSidebar?.querySelector('a.active') || tocSidebar?.querySelector('a')

    const isFocusableElement = (element: Element) =>
        element.matches(
            'a[href], button, input, textarea, select, summary, [tabindex]:not([tabindex="-1"])',
        )

    const isVimVisible = (candidate: HTMLElement) => {
        if (candidate.hidden) return false

        const closedDetails = candidate.closest('details:not([open])')
        if (closedDetails instanceof HTMLDetailsElement) {
            const summary = closedDetails.querySelector('summary')

            if (
                !(summary instanceof HTMLElement) ||
                (summary !== candidate && !summary.contains(candidate))
            ) {
                return false
            }
        }

        const style = window.getComputedStyle(candidate)
        if (style.display === 'none' || style.visibility === 'hidden') {
            return false
        }

        return candidate.getClientRects().length > 0
    }

    const getVisibleMainElements = () =>
        Array.from(
            mainContent.querySelectorAll(
                mainItemQuery,
            ) as NodeListOf<HTMLElement>,
        ).filter(isVimVisible)

    const getNavbarElements = () =>
        navbar
            ? Array.from(
                  navbar.querySelectorAll(
                      navbarQueryString,
                  ) as NodeListOf<HTMLElement>,
              )
            : []

    const isLastNavbarElement = (activeElement: HTMLElement) => {
        const visibleNavbarElements = getNavbarElements().filter(isVimVisible)
        return (
            visibleNavbarElements.length > 0 &&
            activeElement === visibleNavbarElements.at(-1)
        )
    }

    const isPlainPrevKey = (event: KeyboardEvent) =>
        (event.key === 'k' || event.key === 'ArrowUp') &&
        !event.ctrlKey &&
        !event.metaKey &&
        !event.altKey

    const isPlainNextKey = (event: KeyboardEvent) =>
        (event.key === 'j' || event.key === 'ArrowDown') &&
        !event.ctrlKey &&
        !event.metaKey &&
        !event.altKey

    const applyMainContentTabIndex = () => {
        // List containers are navigated via their <li> children,
        // so skip them to avoid a parent-child focus trap.
        const isListContainer = (el: Element) =>
            el.tagName === 'UL' || el.tagName === 'OL'

        // Code blocks are navigated via their individual span.line children,
        // so skip the <pre> wrapper and make each line focusable instead.
        const isCodeBlock = (el: Element) =>
            el.tagName === 'PRE' && el.classList.contains('astro-code')

        // Collapsible heading wrappers — don't make the <details> itself
        // focusable, but recurse into its children (skip the <summary>
        // since it's already focusable).
        const isHeadingCollapse = (el: Element) =>
            el.tagName === 'DETAILS' && el.classList.contains('heading-collapse')

        const processChildren = (container: Element) => {
            Array.from(container.children).forEach((child) => {
                if (!(child instanceof HTMLElement)) return
                if (child.tagName === 'SUMMARY') return
                if (isFocusableElement(child)) return
                if (isListContainer(child)) return
                if (isHeadingCollapse(child)) {
                    processChildren(child)
                    return
                }
                if (isCodeBlock(child)) {
                    child.removeAttribute('tabindex')
                    child.querySelectorAll('span.line').forEach((line) => {
                        if (line instanceof HTMLElement) {
                            line.setAttribute('tabindex', '0')
                        }
                    })
                    return
                }
                if (child.hasAttribute('tabindex')) return
                child.setAttribute('tabindex', '0')
            })
        }

        processChildren(mainContent)

        const listItems = Array.from(mainContent.querySelectorAll('li'))
        listItems.forEach((item) => {
            if (!(item instanceof HTMLElement)) return
            if (isFocusableElement(item)) return
            if (item.hasAttribute('tabindex')) return
            item.setAttribute('tabindex', '0')
        })
    }

    applyMainContentTabIndex()

    // Re-apply after collapsible headings restructure the DOM
    window.addEventListener('headings-collapsed', applyMainContentTabIndex)

    mainContent.addEventListener(
        'keydown',
        (e) => {
            if (e.defaultPrevented || isUserTyping() || !isPlainPrevKey(e)) {
                return
            }

            const activeElement = document.activeElement
            if (!(activeElement instanceof HTMLElement)) return
            if (!mainContent.contains(activeElement)) return

            const visibleMainElements = getVisibleMainElements()
            if (visibleMainElements.length === 0) return
            if (activeElement !== visibleMainElements[0]) return

            const navbarTarget = getNavbarTarget()
            if (!(navbarTarget instanceof HTMLElement)) return

            e.preventDefault()
            e.stopPropagation()
            vimFocusElement(navbarTarget)
        },
        true,
    )

    navbar?.addEventListener(
        'keydown',
        (e) => {
            if (e.defaultPrevented || isUserTyping() || !isPlainNextKey(e)) {
                return
            }

            const activeElement = document.activeElement
            if (!(activeElement instanceof HTMLElement)) return
            if (!navbar.contains(activeElement)) return

            if (!isLastNavbarElement(activeElement)) return

            const elementToFocus =
                getVisibleMainElements()[0] ??
                findFirstFocusableElement() ??
                currentElement ??
                null

            if (!(elementToFocus instanceof HTMLElement)) return

            e.preventDefault()
            e.stopPropagation()
            vimFocusElement(elementToFocus)
        },
        true,
    )

    // Shared via window so the sidebar-toggle script can access z-chord state
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const w = window as any
    w.__pendingZAt = 0
    w.__keyZSpans = document.querySelectorAll(
        '#sidebar-toggle .key-z, #toc-toggle .key-z',
    )
    w.__setKeyActive = (el: Element | null, active: boolean) => {
        if (!el) return
        if (active) {
            el.setAttribute('data-active', 'true')
        } else {
            el.removeAttribute('data-active')
        }
    }

    window.addEventListener('keydown', (e) => {
        if (e.defaultPrevented) return

        const hasOpenDialog =
            document.querySelector('dialog[open]') instanceof HTMLDialogElement
        if (hasOpenDialog) return

        // Don't navigate if the user is typing
        if (isUserTyping()) {
            return
        }

        // Bootstrap focus into main content when j/k is pressed with nothing focused
        const activeElement = document.activeElement
        const isUnfocused =
            !activeElement ||
            activeElement === document.body ||
            activeElement === document.documentElement

        if (
            isUnfocused &&
            !e.ctrlKey &&
            !e.metaKey &&
            !e.altKey &&
            !e.shiftKey
        ) {
            if (e.key === 'j' || e.key === 'ArrowDown') {
                e.preventDefault()
                const firstEl =
                    getVisibleMainElements()[0] ?? findFirstFocusableElement()
                if (firstEl) vimFocusElement(firstEl)
                return
            }
            if (e.key === 'k' || e.key === 'ArrowUp') {
                e.preventDefault()
                const elements = getVisibleMainElements()
                const lastEl = elements[elements.length - 1]
                if (lastEl) vimFocusElement(lastEl)
                return
            }
        }

        // ] / [ — jump to and focus next / previous heading
        if (
            (e.key === ']' || e.key === '[') &&
            !e.ctrlKey &&
            !e.metaKey &&
            !e.altKey &&
            !e.shiftKey
        ) {
            e.preventDefault()
            const scroller = document.getElementById('scroll-container')
            if (!scroller) return

            const headings = Array.from(
                document.querySelectorAll(
                    '#main-content h1[id], #main-content h2[id], #main-content h3[id], #main-content h4[id], #main-content h5[id], #main-content h6[id]',
                ),
            ).map((h) => {
                // If heading is inside a summary (collapsible), target the summary
                const summary = h.closest('summary')
                return (summary ?? h) as HTMLElement
            })
            if (headings.length === 0) return

            const scrollerTop = scroller.getBoundingClientRect().top
            const positions = headings.map(
                (h) => h.getBoundingClientRect().top - scrollerTop,
            )

            const focused = document.activeElement as HTMLElement | null
            const focusRect = focused?.getBoundingClientRect()

            if (e.key === ']') {
                // Find the first heading below the focused element's bottom
                const threshold = focusRect ? focusRect.bottom - scrollerTop : 2
                const idx = positions.findIndex((p) => p > threshold)
                if (idx !== -1) {
                    scroller.scrollTop += positions[idx]
                    headings[idx].focus({ preventScroll: true })
                }
            } else {
                // Find the last heading above the focused element's top
                const threshold = focusRect
                    ? focusRect.top - scrollerTop
                    : scroller.clientHeight
                for (let i = positions.length - 1; i >= 0; i--) {
                    if (positions[i] < threshold - 2) {
                        scroller.scrollTop += positions[i]
                        headings[i].focus({ preventScroll: true })
                        break
                    }
                }
            }
            return
        }

        // } / { — jump to next / previous top-level block
        if (
            (e.key === '}' || e.key === '{') &&
            !e.ctrlKey &&
            !e.metaKey &&
            !e.altKey
        ) {
            e.preventDefault()
            const active = document.activeElement as HTMLElement | null
            if (!active || !mainContent.contains(active)) return

            // Walk up to the direct child of #main-content
            let ancestor: HTMLElement = active
            while (
                ancestor.parentElement &&
                ancestor.parentElement !== mainContent
            ) {
                ancestor = ancestor.parentElement as HTMLElement
            }

            const children = Array.from(mainContent.children) as HTMLElement[]
            const idx = children.indexOf(ancestor)
            if (idx === -1) return

            if (e.key === '}') {
                for (let i = idx + 1; i < children.length; i++) {
                    const child = children[i]
                    if (child.matches(mainItemQuery)) {
                        vimFocusElement(child)
                        return
                    }
                    const desc = child.querySelector(
                        mainItemQuery,
                    ) as HTMLElement | null
                    if (desc) {
                        vimFocusElement(desc)
                        return
                    }
                }
            } else {
                for (let i = idx - 1; i >= 0; i--) {
                    const child = children[i]
                    if (child.matches(mainItemQuery)) {
                        vimFocusElement(child)
                        return
                    }
                    const desc = child.querySelector(
                        mainItemQuery,
                    ) as HTMLElement | null
                    if (desc) {
                        vimFocusElement(desc)
                        return
                    }
                }
            }
            return
        }

        // ctrl-o -> "navigate out"
        if (e.key === 'o' && e.ctrlKey) {
            e.preventDefault()
            window.history.back()
        }

        // ctrl-i -> "navigate in"
        if (e.key === 'i' && e.ctrlKey) {
            e.preventDefault()
            window.history.forward()
        }

        // ctrl-d / ctrl-u — half-page scroll with focus follow
        if (
            (e.key === 'd' || e.key === 'u') &&
            e.ctrlKey &&
            !e.metaKey &&
            !e.altKey
        ) {
            e.preventDefault()
            const scroller = document.getElementById('scroll-container')
            if (!scroller) return
            const halfPage = scroller.clientHeight / 2
            scroller.scrollBy({
                top: e.key === 'd' ? halfPage : -halfPage,
                behavior: 'instant',
            })
            const visible = getVisibleMainElements()
            if (visible.length > 0) {
                vimFocusElement(visible[0])
            }
            return
        }

        // Skip all plain keys when z-chord is pending — the sidebar-toggle script handles it
        {
            // eslint-disable-next-line @typescript-eslint/no-explicit-any
            const pz = (window as any).__pendingZAt
            if (
                pz &&
                Date.now() - pz <= 700 &&
                !e.ctrlKey &&
                !e.metaKey &&
                !e.altKey &&
                !e.shiftKey
            ) {
                return
            }
        }

        const isShiftRegionKey =
            e.shiftKey &&
            !e.ctrlKey &&
            !e.metaKey &&
            !e.altKey &&
            ['h', 'j', 'k', 'l'].includes(e.key.toLowerCase())

        if (isShiftRegionKey) {
            const shiftedKey = e.key.toLowerCase()
            let target: HTMLElement | null = null

            if (shiftedKey === 'h') {
                target = getSidebarTarget() as HTMLElement | null
            }

            if (shiftedKey === 'j') {
                target =
                    getVisibleMainElements()[0] ??
                    findFirstFocusableElement() ??
                    currentElement ??
                    null
            }

            if (shiftedKey === 'k') {
                target = getNavbarTarget() as HTMLElement | null
            }

            if (shiftedKey === 'l') {
                target = getTocTarget() as HTMLElement | null
            }

            if (target instanceof HTMLElement) {
                e.preventDefault()
                vimFocusElement(target)
            }

            return
        }

        if (e.key === 'h' && !e.ctrlKey && !e.metaKey && !e.altKey) {
            const activeElement = document.activeElement

            if (activeElement && mainContent.contains(activeElement)) {
                e.preventDefault()
                const target = getSidebarTarget()
                if (target instanceof HTMLElement) {
                    vimFocusElement(target)
                }
                return
            }

            if (activeElement && tocSidebar?.contains(activeElement)) {
                e.preventDefault()
                const elementToFocus =
                    currentElement ?? findFirstFocusableElement() ?? null

                if (elementToFocus) {
                    vimFocusElement(elementToFocus)
                }
                return
            }
        }

        if (e.key === 'l' && !e.ctrlKey && !e.metaKey && !e.altKey) {
            const activeElement = document.activeElement

            if (activeElement && sidebar?.contains(activeElement)) {
                e.preventDefault()
                const elementToFocus =
                    currentElement ?? findFirstFocusableElement() ?? null

                if (elementToFocus) {
                    vimFocusElement(elementToFocus)
                }
                return
            }

            if (activeElement && mainContent.contains(activeElement)) {
                const target = getTocTarget()
                if (target instanceof HTMLElement) {
                    e.preventDefault()
                    vimFocusElement(target)
                }
            }
        }

        const nextHref = document.querySelector('.next')?.getAttribute('href')
        const prevHref = document.querySelector('.prev')?.getAttribute('href')

        if (
            e.key === 'n' &&
            !e.ctrlKey &&
            !e.metaKey &&
            !e.altKey &&
            nextHref
        ) {
            e.preventDefault()
            window.location.href = nextHref
        }

        if (
            e.key === 'b' &&
            !e.ctrlKey &&
            !e.metaKey &&
            !e.altKey &&
            prevHref
        ) {
            e.preventDefault()
            window.location.href = prevHref
        }
    })

    applyVimNavigation(mainContent, queryString, (element) => {
        currentElement = element
    })

    if (navbar) {
        applyVimNavigation(navbar, navbarQueryString)
    }

    if (tocSidebar) {
        applyVimNavigation(tocSidebar, 'a[href]')
    }
</script>

<!-- Heading Anchor Links -->
<script>
    const headingContainer = document.getElementById('main-content')

    if (headingContainer) {
        const headingNodes = headingContainer.querySelectorAll(
            'h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]',
        )

        headingNodes.forEach((heading) => {
            if (!(heading instanceof HTMLElement)) return
            if (heading.querySelector(':scope > a.heading-anchor')) return

            const slug = heading.id
            if (!slug) return

            const level = parseInt(heading.tagName[1], 10)
            const anchor = document.createElement('a')
            anchor.className = 'heading-anchor'
            anchor.href = `#${slug}`
            anchor.setAttribute(
                'aria-label',
                `Link to section ${heading.textContent ?? ''}`,
            )
            anchor.textContent = '#'.repeat(level)
            anchor.style.marginInlineEnd = '1ch'
            heading.prepend(anchor)
        })
    }
</script>

<!-- TOC Active Heading -->
<script>
    const scrollContainer = document.getElementById(
        'scroll-container',
    ) as HTMLElement | null
    const tocLinks = Array.from(
        document.querySelectorAll('#toc-list a[data-heading-slug]'),
    ) as HTMLAnchorElement[]

    if (scrollContainer && tocLinks.length > 0) {
        const headingElements = tocLinks
            .map((link) => {
                const slug = link.dataset.headingSlug
                if (!slug) return null
                return document.getElementById(slug)
            })
            .filter(
                (element): element is HTMLElement =>
                    element instanceof HTMLElement,
            )

        const setActiveTocLink = (activeId: string) => {
            // Find the active link and its parent H2 section
            let activeH2Slug: string | null = null
            for (const link of tocLinks) {
                if (link.dataset.headingSlug === activeId) {
                    // Walk backwards to find the owning H2
                    if (link.classList.contains('depth-2')) {
                        activeH2Slug = activeId
                    } else {
                        // Search backwards through tocLinks for nearest depth-2
                        const idx = tocLinks.indexOf(link)
                        for (let i = idx - 1; i >= 0; i--) {
                            if (tocLinks[i].classList.contains('depth-2')) {
                                activeH2Slug =
                                    tocLinks[i].dataset.headingSlug ?? null
                                break
                            }
                        }
                    }
                    break
                }
            }

            // Update active class and reveal sub-headings for active H2 section
            let currentH2Slug: string | null = null
            tocLinks.forEach((link) => {
                const slug = link.dataset.headingSlug
                link.classList.toggle('active', slug === activeId)

                if (link.classList.contains('depth-2')) {
                    currentH2Slug = slug ?? null
                }

                const li = link.parentElement
                if (li && !link.classList.contains('depth-2')) {
                    li.classList.toggle(
                        'toc-visible',
                        currentH2Slug === activeH2Slug,
                    )
                }
            })
        }

        const syncActiveHeading = () => {
            const containerTop = scrollContainer.getBoundingClientRect().top
            let activeHeading = headingElements[0]

            for (const heading of headingElements) {
                const top = heading.getBoundingClientRect().top - containerTop
                if (top <= 24) {
                    activeHeading = heading
                } else {
                    break
                }
            }

            if (activeHeading) {
                setActiveTocLink(activeHeading.id)
                const activeLink = document.querySelector(
                    '#toc-list a.active',
                ) as HTMLAnchorElement | null
                activeLink?.scrollIntoView({ block: 'nearest' })

                // Update the article border label with the active heading
                const titleEl = document.querySelector(
                    '#doc-article > header h1',
                ) as HTMLElement | null
                const mainEl = document.getElementById('main-content')
                if (titleEl && mainEl) {
                    if (titleEl.dataset.originalHtml === undefined) {
                        titleEl.dataset.originalHtml = titleEl.innerHTML
                    }

                    // Find the nearest heading (walk up through
                    // collapsible wrappers to find the actual heading)
                    let target: HTMLElement | null = null
                    if (/^H[1-6]$/.test(activeHeading.tagName)) {
                        target = activeHeading
                    } else {
                        const collapse = activeHeading.closest?.(
                            '.heading-collapse',
                        )
                        target = collapse?.querySelector(
                            'summary :is(h1,h2,h3,h4,h5,h6)',
                        ) as HTMLElement | null
                    }

                    // Only show in border once the heading has scrolled
                    // above the visible content area
                    const headingAbove = target
                        ? target.getBoundingClientRect().bottom <
                          mainEl.getBoundingClientRect().top
                        : false

                    if (headingAbove && target) {
                        const level = parseInt(target.tagName[1])
                        const prefix = '#'.repeat(level)
                        const colorVar = `var(--h${level})`
                        const clone = target.cloneNode(true) as HTMLElement
                        clone.querySelector('.heading-anchor')?.remove()
                        const text = clone.textContent?.trim() ?? ''
                        if (text) {
                            titleEl.style.setProperty('--h1-prefix', 'none')
                            titleEl.style.color = colorVar
                            titleEl.innerHTML = `<span class="heading-anchor" style="color: ${colorVar}; margin-inline-end: 1ch;">${prefix}</span>${text}`
                        }
                    } else {
                        titleEl.style.removeProperty('--h1-prefix')
                        titleEl.style.removeProperty('color')
                        titleEl.innerHTML = titleEl.dataset.originalHtml
                    }
                }
            }
        }

        // Use capture to intercept scroll events from any ancestor
        // (the actual scroller may be #scroll-container, article, or body)
        document.addEventListener('scroll', syncActiveHeading, {
            passive: true,
            capture: true,
        })
        window.addEventListener('hashchange', syncActiveHeading)
        syncActiveHeading()
    }
</script>

<!-- Sidebar Toggle -->
<script>
    import { isUserTyping, vimFocusElement } from '@/utils/vim'

    const sidebarToggle = document.getElementById(
        'sidebar-toggle',
    ) as HTMLButtonElement | null
    const tocToggle = document.getElementById(
        'toc-toggle',
    ) as HTMLButtonElement | null
    const sidebarContainer = document.getElementById(
        'sidebar-container',
    ) as HTMLDivElement | null
    const tocContainer = document.getElementById(
        'toc-container',
    ) as HTMLDivElement | null
    const navbar = document.getElementById('top-navbar') as HTMLElement | null
    const mainContent = document.getElementById(
        'main-content',
    ) as HTMLElement | null

    const setSidebarToggleLabel = (collapsed: boolean) => {
        if (!sidebarToggle) return

        const arrow = collapsed ? '&uarr;' : '&larr;'
        sidebarToggle.innerHTML = `${arrow}<span class="key-z">z</span>[<span class="key-h">h</span>]`

        sidebarToggle.setAttribute(
            'aria-label',
            collapsed
                ? 'Expand left sidebar (zh)'
                : 'Collapse left sidebar (zh)',
        )
    }

    const setTocToggleLabel = (collapsed: boolean) => {
        if (!tocToggle) return

        const arrow = collapsed ? '&darr;' : '&rarr;'
        tocToggle.innerHTML = `<span class="key-z">z</span>[<span class="key-l">l</span>]${arrow}`
        tocToggle.setAttribute(
            'aria-label',
            collapsed
                ? 'Expand right sidebar (zl)'
                : 'Collapse right sidebar (zl)',
        )
    }

    const refreshKeySpans = () => {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        ;(window as any).__keyZSpans = document.querySelectorAll(
            '#sidebar-toggle .key-z, #toc-toggle .key-z',
        )
    }

    const setSidebarCollapsed = (collapsed: boolean) => {
        if (!sidebarContainer || !sidebarToggle) return

        sidebarContainer.classList.toggle('collapsed', collapsed)
        sidebarToggle.setAttribute('aria-expanded', String(!collapsed))
        localStorage.setItem('sidebar-collapsed', String(collapsed))
        setSidebarToggleLabel(collapsed)
        refreshKeySpans()
    }

    const setTocCollapsed = (collapsed: boolean) => {
        if (!tocContainer || !tocToggle) return

        tocContainer.classList.toggle('collapsed', collapsed)
        tocToggle.setAttribute('aria-expanded', String(!collapsed))
        localStorage.setItem('toc-collapsed', String(collapsed))
        setTocToggleLabel(collapsed)
        refreshKeySpans()
    }

    const getSidebarFocusTarget = () =>
        document.querySelector(
            '#sidebar a.active, #sidebar details summary, #sidebar a[href]',
        ) as HTMLElement | null

    const getTocFocusTarget = () =>
        document.querySelector(
            '#toc-sidebar a.active, #toc-sidebar a[href]',
        ) as HTMLElement | null

    const isElementVisible = (element: HTMLElement) => {
        if (element.hidden) return false

        const style = window.getComputedStyle(element)
        if (style.display === 'none' || style.visibility === 'hidden') {
            return false
        }

        return element.getClientRects().length > 0
    }

    const getNavbarFocusTarget = () =>
        navbar?.querySelector(
            'a[data-active="true"], a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        )

    const getMainFocusTarget = () => {
        if (!mainContent) return null

        const activeElement = document.activeElement
        if (
            activeElement instanceof HTMLElement &&
            mainContent.contains(activeElement)
        ) {
            return activeElement
        }

        const candidates = Array.from(
            mainContent.querySelectorAll(
                '[tabindex="0"], a[href], summary',
            ) as NodeListOf<HTMLElement>,
        )

        return candidates.find(isElementVisible) ?? null
    }

    if (sidebarToggle && sidebarContainer) {
        const isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true'
        setSidebarCollapsed(isCollapsed)

        sidebarToggle.addEventListener('click', () => {
            setSidebarCollapsed(
                !sidebarContainer.classList.contains('collapsed'),
            )
        })
    }

    if (tocToggle && tocContainer) {
        const isCollapsed = localStorage.getItem('toc-collapsed') !== 'false'
        setTocCollapsed(isCollapsed)

        tocToggle.addEventListener('click', () => {
            setTocCollapsed(!tocContainer.classList.contains('collapsed'))
        })
    }

    if (sidebarContainer || tocContainer || navbar || mainContent) {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const w = window as any

        window.addEventListener('keydown', (e) => {
            if (isUserTyping()) return

            const hasOpenDialog =
                document.querySelector('dialog[open]') instanceof
                HTMLDialogElement
            if (hasOpenDialog) return

            const isPlainKey =
                !e.ctrlKey && !e.metaKey && !e.altKey && !e.shiftKey

            if (isPlainKey) {
                const now = Date.now()

                if (e.key === 'z') {
                    if (w.__pendingZAt && now - w.__pendingZAt <= 700) {
                        w.__pendingZAt = 0
                        w.__keyZSpans?.forEach((s: Element) =>
                            w.__setKeyActive?.(s, false),
                        )
                        return
                    }

                    w.__pendingZAt = now
                    w.__keyZSpans?.forEach((s: Element) =>
                        w.__setKeyActive?.(s, true),
                    )
                    setTimeout(() => {
                        if (
                            w.__pendingZAt &&
                            Date.now() - w.__pendingZAt >= 690
                        ) {
                            w.__pendingZAt = 0
                            w.__keyZSpans?.forEach((s: Element) =>
                                w.__setKeyActive?.(s, false),
                            )
                        }
                    }, 700)
                    return
                }

                if (e.key === '[' || e.key === ']') {
                    w.__pendingZAt = 0
                    return // handled by heading-jump listener
                }

                const hasPendingZChord =
                    w.__pendingZAt > 0 && now - w.__pendingZAt <= 700
                w.__pendingZAt = 0
                w.__keyZSpans?.forEach((s: Element) =>
                    w.__setKeyActive?.(s, false),
                )

                if (hasPendingZChord) {
                    if (e.key === 'h') {
                        e.preventDefault()
                        setSidebarCollapsed(
                            !sidebarContainer?.classList.contains('collapsed'),
                        )
                        return
                    }

                    if (e.key === 'l') {
                        e.preventDefault()
                        setTocCollapsed(
                            !tocContainer?.classList.contains('collapsed'),
                        )
                        return
                    }

                    if (e.key === 'j') {
                        e.preventDefault()
                        const mainTarget = getMainFocusTarget()
                        if (mainTarget instanceof HTMLElement) {
                            vimFocusElement(mainTarget)
                        }
                        return
                    }

                    if (e.key === 'k') {
                        e.preventDefault()
                        const navbarTarget = getNavbarFocusTarget()
                        if (navbarTarget instanceof HTMLElement) {
                            vimFocusElement(navbarTarget)
                        }
                        return
                    }

                    if (e.key === 'M') {
                        e.preventDefault()
                        document
                            .querySelectorAll(
                                '#main-content details[open]',
                            )
                            .forEach((d) => {
                                ;(d as HTMLDetailsElement).open = false
                            })
                        return
                    }

                    if (e.key === 'R') {
                        e.preventDefault()
                        document
                            .querySelectorAll(
                                '#main-content details:not([open])',
                            )
                            .forEach((d) => {
                                ;(d as HTMLDetailsElement).open = true
                            })
                        return
                    }
                    return
                }
            } else {
                // Allow z-chord with Shift for zM/zR (collapse/expand all)
                if (
                    e.shiftKey &&
                    !e.ctrlKey &&
                    !e.metaKey &&
                    !e.altKey &&
                    w.__pendingZAt > 0 &&
                    Date.now() - w.__pendingZAt <= 700
                ) {
                    w.__pendingZAt = 0
                    w.__keyZSpans?.forEach((s: Element) =>
                        w.__setKeyActive?.(s, false),
                    )
                    if (e.key === 'M') {
                        e.preventDefault()
                        document
                            .querySelectorAll('#main-content details[open]')
                            .forEach((d) => {
                                ;(d as HTMLDetailsElement).open = false
                            })
                        return
                    }
                    if (e.key === 'R') {
                        e.preventDefault()
                        document
                            .querySelectorAll(
                                '#main-content details:not([open])',
                            )
                            .forEach((d) => {
                                ;(d as HTMLDetailsElement).open = true
                            })
                        return
                    }
                }
                w.__pendingZAt = 0
                w.__keyZSpans?.forEach((s: Element) =>
                    w.__setKeyActive?.(s, false),
                )
            }

            if (!e.ctrlKey || e.metaKey || e.altKey || e.shiftKey) return

            const key = e.key.toLowerCase()

            if (key === 'h') {
                e.preventDefault()
                const sidebarTarget = getSidebarFocusTarget()
                if (sidebarTarget instanceof HTMLElement) {
                    vimFocusElement(sidebarTarget)
                }
                return
            }

            if (key === 'l') {
                e.preventDefault()
                const tocTarget = getTocFocusTarget()
                if (tocTarget instanceof HTMLElement) {
                    vimFocusElement(tocTarget)
                }
                return
            }

            if (key === 'j') {
                e.preventDefault()
                const mainTarget = getMainFocusTarget()
                if (mainTarget instanceof HTMLElement) {
                    vimFocusElement(mainTarget)
                }
            }

            if (key === 'k') {
                e.preventDefault()
                const navbarTarget = getNavbarFocusTarget()
                if (navbarTarget instanceof HTMLElement) {
                    vimFocusElement(navbarTarget)
                }
            }
        })
    }
</script>

<!-- TOC Resize -->
<script>
    const tocContainer = document.getElementById(
        'toc-container',
    ) as HTMLElement | null
    const tocResizer = document.getElementById(
        'toc-resizer',
    ) as HTMLDivElement | null

    if (tocContainer && tocResizer) {
        const setTocWidth = (widthPx: number) => {
            tocContainer.style.setProperty('--toc-width', `${widthPx}px`)
        }

        const getBounds = () => {
            const styles = window.getComputedStyle(tocContainer)
            const minWidth = parseFloat(styles.minWidth)
            const maxWidth = parseFloat(styles.maxWidth)
            return { minWidth, maxWidth }
        }

        const storedWidth = localStorage.getItem('toc-width')
        if (storedWidth) {
            const widthPx = Number(storedWidth)
            if (!Number.isNaN(widthPx)) {
                setTocWidth(widthPx)
            }
        }

        const onMouseMove = (event: MouseEvent) => {
            const { right } = tocContainer.getBoundingClientRect()
            const { minWidth, maxWidth } = getBounds()
            const rawWidth = right - event.clientX
            const nextWidth = Math.min(maxWidth, Math.max(minWidth, rawWidth))
            setTocWidth(nextWidth)
        }

        const onMouseUp = () => {
            tocResizer.classList.remove('dragging')
            const styles = window.getComputedStyle(tocContainer)
            const widthPx = parseFloat(styles.width)
            if (!Number.isNaN(widthPx)) {
                localStorage.setItem('toc-width', String(widthPx))
            }
            window.removeEventListener('mousemove', onMouseMove)
            window.removeEventListener('mouseup', onMouseUp)
        }

        tocResizer.addEventListener('mousedown', (event) => {
            if (tocContainer.classList.contains('collapsed')) {
                return
            }

            event.preventDefault()
            tocResizer.classList.add('dragging')
            window.addEventListener('mousemove', onMouseMove)
            window.addEventListener('mouseup', onMouseUp)
        })
    }
</script>

<!-- Sidebar Resize -->
<script>
    const sidebarContainer = document.getElementById(
        'sidebar-container',
    ) as HTMLDivElement | null
    const sidebarResizer = document.getElementById(
        'sidebar-resizer',
    ) as HTMLDivElement | null

    if (sidebarContainer && sidebarResizer) {
        const setSidebarWidth = (widthPx: number) => {
            sidebarContainer.style.setProperty(
                '--sidebar-width',
                `${widthPx}px`,
            )
        }

        const getBounds = () => {
            const styles = window.getComputedStyle(sidebarContainer)
            const minWidth = parseFloat(styles.minWidth)
            const maxWidth = parseFloat(styles.maxWidth)
            return { minWidth, maxWidth }
        }

        const storedWidth = localStorage.getItem('sidebar-width')
        if (storedWidth) {
            const widthPx = Number(storedWidth)
            if (!Number.isNaN(widthPx)) {
                setSidebarWidth(widthPx)
            }
        }

        const onMouseMove = (event: MouseEvent) => {
            const { left } = sidebarContainer.getBoundingClientRect()
            const { minWidth, maxWidth } = getBounds()
            const rawWidth = event.clientX - left
            const nextWidth = Math.min(maxWidth, Math.max(minWidth, rawWidth))
            setSidebarWidth(nextWidth)
        }

        const onMouseUp = () => {
            sidebarResizer.classList.remove('dragging')
            const styles = window.getComputedStyle(sidebarContainer)
            const widthPx = parseFloat(styles.width)
            if (!Number.isNaN(widthPx)) {
                localStorage.setItem('sidebar-width', String(widthPx))
            }
            window.removeEventListener('mousemove', onMouseMove)
            window.removeEventListener('mouseup', onMouseUp)
        }

        sidebarResizer.addEventListener('mousedown', (event) => {
            if (sidebarContainer.classList.contains('collapsed')) {
                return
            }

            event.preventDefault()
            sidebarResizer.classList.add('dragging')
            window.addEventListener('mousemove', onMouseMove)
            window.addEventListener('mouseup', onMouseUp)
        })
    }
</script>

<!-- Mobile Navigation -->
<script>
    const menuButton = document.getElementById(
        'menu-button',
    ) as HTMLButtonElement
    const docsButton = document.getElementById(
        'docs-button',
    ) as HTMLButtonElement
    const tocButton = document.getElementById(
        'toc-button',
    ) as HTMLButtonElement | null
    const sidebarContainer = document.getElementById(
        'sidebar-container',
    ) as HTMLDivElement
    const tocContainer = document.getElementById(
        'toc-container',
    ) as HTMLElement | null
    const article = document.querySelector('article') as HTMLElement

    function setMobileActive(panel: 'menu' | 'docs' | 'toc') {
        sidebarContainer.classList.toggle('mobile-hidden', panel !== 'menu')
        article.classList.toggle('mobile-hidden', panel !== 'docs')
        tocContainer?.classList.toggle('mobile-hidden', panel !== 'toc')
        tocContainer?.classList.toggle('collapsed', panel !== 'toc')
        menuButton.setAttribute(
            'variant-',
            panel === 'menu' ? '' : 'background1',
        )
        docsButton.setAttribute(
            'variant-',
            panel === 'docs' ? '' : 'background1',
        )
        tocButton?.setAttribute(
            'variant-',
            panel === 'toc' ? '' : 'background1',
        )
    }

    menuButton.addEventListener('click', () => setMobileActive('menu'))
    docsButton.addEventListener('click', () => setMobileActive('docs'))
    tocButton?.addEventListener('click', () => setMobileActive('toc'))
</script>

<script>
    const mainContent = document.getElementById('main-content')
    const progressBar = document.getElementById('scroll-progress')

    if (mainContent && progressBar) {
        mainContent.addEventListener('scroll', () => {
            const scrollTop = mainContent.scrollTop
            const scrollHeight =
                mainContent.scrollHeight - mainContent.clientHeight
            const progress =
                scrollHeight > 0 ? Math.min(scrollTop / scrollHeight, 1) : 0
            progressBar.style.transform = `scaleX(${progress})`
        })
    }
