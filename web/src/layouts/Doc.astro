<!-- Footnote hover tooltips -->
<script>
    const footnoteRefs = document.querySelectorAll('a[data-footnote-ref]')
    for (const ref of footnoteRefs) {
        const id = ref.getAttribute('href')?.replace('#', '')
        if (!id) continue
        const footnoteLi = document.getElementById(id)
        if (!footnoteLi) continue

        // Clone footnote content, excluding the back-reference link
        const clone = footnoteLi.cloneNode(true) as HTMLElement
        clone
            .querySelectorAll('a[data-footnote-backref]')
            .forEach((a) => a.remove())

        // Build popover: <details is-="popover"><summary>...<sup></summary><div>...</div></details>
        const sup = ref.parentElement
        if (!sup || sup.tagName !== 'SUP') continue
        const parent = sup.parentElement
        if (!parent) continue

        const details = document.createElement('details')
        details.setAttribute('is-', 'popover')
        details.setAttribute('position-', 'bottom')
        details.classList.add('footnote-popover')

        const summary = document.createElement('summary')
        summary.appendChild(sup.cloneNode(true))

        const content = document.createElement('div')
        content.classList.add('footnote-popover-content')
        content.innerHTML = clone.innerHTML

        details.appendChild(summary)
        details.appendChild(content)

        // Replace original <sup> with the popover
        parent.insertBefore(details, sup)
        sup.remove()

        // Open/close on hover
        details.addEventListener('mouseenter', () => {
            details.open = true
        })
        details.addEventListener('mouseleave', () => {
            details.open = false
        })

        // Keyboard/focus accessibility
        details.addEventListener('focusin', () => {
            details.open = true
        })
        details.addEventListener('focusout', (e) => {
            const next = (e as FocusEvent).relatedTarget as Node | null
            if (!next || !details.contains(next)) {
                details.open = false
            }
        })

        // Toggle on click/tap instead of following anchor
        const summaryLink = summary.querySelector('a')
        summaryLink?.addEventListener('click', (e) => {
            e.preventDefault()
            details.open = !details.open
        })
    }
</script>

