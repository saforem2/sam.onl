<!-- Code block copy buttons -->
<script>
    const codeBlocks = document.querySelectorAll('pre.astro-code')
    for (const block of codeBlocks) {
        block.style.position = 'relative'

        const button = document.createElement('button')
        button.className = 'code-copy-btn'
        button.textContent = 'copy'
        button.addEventListener('click', async () => {
            const code = block.querySelector('code')
            if (!code) return
            try {
                await navigator.clipboard.writeText(code.innerText)
                button.textContent = 'copied!'
            } catch {
                button.textContent = 'failed'
            }
            setTimeout(() => {
                button.textContent = 'copy'
            }, 2000)
        })
        block.appendChild(button)
    }
</script>

<!-- Vim statusline scroll position + clock -->
<script>
    const mainContent = document.getElementById('main-content')
    const posEl = document.querySelector('.vsl-pos')
    const locEl = document.querySelector('.vsl-loc')
    const clockEl = document.getElementById('vsl-clock-text')

    if (mainContent && posEl) {
        const update = () => {
            const scrollTop = mainContent.scrollTop
            const scrollHeight =
                mainContent.scrollHeight - mainContent.clientHeight
            if (scrollHeight <= 0) {
                posEl.textContent = 'All'
            } else {
                posEl.textContent =
                    Math.round((scrollTop / scrollHeight) * 100) + '%'
            }
            // Approximate line number from scroll position
            const totalLines = Math.ceil(mainContent.scrollHeight / 24)
            const currentLine = Math.max(
                1,
                Math.ceil((scrollTop / mainContent.scrollHeight) * totalLines),
            )
            if (locEl) locEl.textContent = `${currentLine}:1`
        }
        mainContent.addEventListener('scroll', update)
        update()
    }

    // Live clock
    if (clockEl) {
        const pad = (n: number) => String(n).padStart(2, '0')
        const tick = () => {
            const d = new Date()
            clockEl.textContent = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`
        }
        tick()
        setInterval(tick, 10_000)
    }

    // Visual feedback for statusline keys + last-key indicator
    const vslBtnJ = document.getElementById('vsl-btn-j')
    const vslBtnK = document.getElementById('vsl-btn-k')
    const vslBtnQ = document.getElementById('vsl-btn-q')
    const lastKeyEl = document.getElementById('vsl-last-key')
    let lastKeyTimer: ReturnType<typeof setTimeout> | null = null
    const keyMap: Record<string, HTMLElement | null> = {
        j: vslBtnJ,
        ArrowDown: vslBtnJ,
        k: vslBtnK,
        ArrowUp: vslBtnK,
        '?': vslBtnQ,
    }
    window.addEventListener('keydown', (e) => {
        const btn = keyMap[e.key]
        if (btn) btn.style.color = 'var(--foreground0)'
        // Show last pressed key
        if (lastKeyEl && e.key.length === 1) {
            lastKeyEl.textContent = e.key
            if (lastKeyTimer) clearTimeout(lastKeyTimer)
            lastKeyTimer = setTimeout(() => {
                lastKeyEl.textContent = ''
            }, 2000)
        }
    })
    window.addEventListener('keyup', (e) => {
        const btn = keyMap[e.key]
        if (btn) btn.style.color = ''
    })
</script>

<!-- Collapsible headings: wrap h2-h6 sections in <details> -->
<script>
    const mainContent = document.getElementById('main-content')
    if (mainContent) {
        // Process each heading level top-down (h2 first, then h3, etc.)
        // so parent sections are established before children are wrapped
        for (let level = 2; level <= 6; level++) {
            const tag = `H${level}`
            // Find headings at this level — search within mainContent
            // and within already-created .heading-collapse details
            const headings = Array.from(
                mainContent.querySelectorAll(
                    `:scope > ${tag}, :scope > .heading-collapse ${tag}`,
                ),
            ).filter(
                // Only direct content headings, not ones inside summary
                (h) => !h.closest('summary'),
            ) as HTMLElement[]

            for (const heading of headings) {
                const parent = heading.parentNode!
                const details = document.createElement('details')
                details.setAttribute('is-', 'accordion')
                details.classList.add('heading-collapse')
                // Collapse year-section headings (e.g. "📆 2025") by default
                const headingText = heading.textContent?.trim() ?? ''
                details.open = !/\b(19|20)\d{2}\s*$/.test(headingText)
                details.dataset.headingLevel = String(level)
                const summary = document.createElement('summary')
                summary.appendChild(heading.cloneNode(true))
                details.appendChild(summary)
                parent.insertBefore(details, heading)
                heading.remove()
                // Collect siblings until next heading of same or higher level,
                // or a container that holds such a heading
                const headingSelector = Array.from(
                    { length: level },
                    (_, i) => `h${i + 1}`,
                ).join(',')
                let next = details.nextSibling
                while (next) {
                    const sibling = next
                    next = sibling.nextSibling
                    if (sibling.nodeType === 1) {
                        const el = sibling as HTMLElement
                        if (
                            /^H[1-6]$/.test(el.tagName) &&
                            parseInt(el.tagName[1]) <= level
                        ) {
                            break
                        }
                        if (el.querySelector(headingSelector)) {
                            break
                        }
                    }
                    details.appendChild(sibling)
                }
            }
        }
        // Signal vim navigation to re-apply tabindex to restructured content
        window.dispatchEvent(new Event('headings-collapsed'))
    }
</script>

