---
import Layout from '@/layouts/Layout.astro'
import Presentation from '@/components/slides/Presentation.astro'

interface Props {
    frontmatter?: { title?: string; description?: string }
    title?: string
    description?: string
}
const fm = (Astro.props as Props).frontmatter ?? {}
const title = (Astro.props as Props).title ?? fm.title
const description = (Astro.props as Props).description ?? fm.description
---

<Layout {title} {description}>
    <Presentation {title}>
        <slot />
    </Presentation>
</Layout>

{
    /*
  KaTeX CSS lives here (the deck path's analogue of Doc.astro) rather than in the
  every-page global.css. Decks render via SlideLayout -> Layout -> Presentation and
  never touch Doc.astro, so without this a deck's inline $...$ math shows twice: the
  visual render plus KaTeX's hidden MathML copy (the .katex-mathml display:none rule
  only ships inside katex.min.css). Keeping it deck-scoped leaves the landing and
  other Layout-direct pages KaTeX-free.
*/
}
<style is:global>
    @import 'katex/dist/katex.min.css';
</style>
