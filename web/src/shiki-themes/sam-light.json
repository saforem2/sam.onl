{
    "name": "sam-light",
    "type": "light",
    "displayName": "samf.sh Light",
    "colors": {
        "editor.background": "#f8f8f8",
        "editor.foreground": "#262626",
        "editor.lineHighlightBackground": "#ebebeb",
        "editor.selectionBackground": "#ff1a8f33",
        "editorCursor.foreground": "#ff1a8f",
        "editorLineNumber.foreground": "#b5b5b5",
        "editorLineNumber.activeForeground": "#666666"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "foreground": "#999999", "fontStyle": "italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.template",
                "string.quoted",
                "meta.string"
            ],
            "settings": { "foreground": "#05a551" }
        },
        {
            "name": "String Escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#1da912" }
        },
        {
            "name": "Numeric / Boolean / Null",
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.nan",
                "constant.language.infinity"
            ],
            "settings": { "foreground": "#ff5722" }
        },
        {
            "name": "Other constants",
            "scope": ["constant", "constant.other", "support.constant"],
            "settings": { "foreground": "#ff5722" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical",
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": { "foreground": "#ff1a8f", "fontStyle": "" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace",
                "punctuation.section"
            ],
            "settings": { "foreground": "#666666" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function",
                "meta.function entity.name.function"
            ],
            "settings": { "foreground": "#2196f3" }
        },
        {
            "name": "Function Parameter",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#262626" }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "support.variable",
                "meta.definition.variable variable"
            ],
            "settings": { "foreground": "#262626" }
        },
        {
            "name": "Property",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key",
                "support.type.property-name"
            ],
            "settings": { "foreground": "#5e35b1" }
        },
        {
            "name": "Type / Class",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type",
                "meta.type"
            ],
            "settings": { "foreground": "#5e35b1" }
        },
        {
            "name": "Constant Language Alt",
            "scope": ["constant.language", "variable.language"],
            "settings": { "foreground": "#5e35b1" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#ff1a8f" }
        },
        {
            "name": "Tag Punctuation",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end"
            ],
            "settings": { "foreground": "#999999" }
        },
        {
            "name": "HTML/JSX Attribute",
            "scope": [
                "entity.other.attribute-name",
                "meta.attribute.entity.other.attribute-name"
            ],
            "settings": { "foreground": "#5e35b1", "fontStyle": "italic" }
        },
        {
            "name": "CSS Property",
            "scope": ["support.type.property-name.css", "meta.property-name"],
            "settings": { "foreground": "#2196f3" }
        },
        {
            "name": "CSS Value",
            "scope": [
                "support.constant.property-value.css",
                "meta.property-value"
            ],
            "settings": { "foreground": "#ff5722" }
        },
        {
            "name": "CSS Selector",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.name.tag.css"
            ],
            "settings": { "foreground": "#ff1a8f" }
        },
        {
            "name": "JSON Key",
            "scope": [
                "support.type.property-name.json",
                "meta.structure.dictionary.json string.quoted.double.json"
            ],
            "settings": { "foreground": "#2196f3" }
        },
        {
            "name": "Markdown heading",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#ff1a8f", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold", "markup.bold markup.italic"],
            "settings": { "foreground": "#262626", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic", "markup.italic markup.bold"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown inline code",
            "scope": ["markup.inline.raw", "markup.raw"],
            "settings": { "foreground": "#05a551" }
        },
        {
            "name": "Markdown link text",
            "scope": ["string.other.link.title.markdown", "markup.underline.link"],
            "settings": { "foreground": "#2196f3" }
        },
        {
            "name": "Diff Added",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#05a551" }
        },
        {
            "name": "Diff Removed",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#ff5722" }
        },
        {
            "name": "Diff Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#5e35b1" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff5722", "fontStyle": "underline" }
        }
    ]
}
