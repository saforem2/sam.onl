{
    "name": "sam-dark",
    "type": "dark",
    "displayName": "samf.sh Dark (glitz)",
    "colors": {
        "editor.background": "#1c1c1c",
        "editor.foreground": "#cccccc",
        "editor.lineHighlightBackground": "#262626",
        "editor.selectionBackground": "#ff408133",
        "editorCursor.foreground": "#ff0080",
        "editorLineNumber.foreground": "#404040",
        "editorLineNumber.activeForeground": "#8f8f8f"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": { "foreground": "#404040", "fontStyle": "italic" }
        },
        {
            "name": "Special Comment (TODO, FIXME, …)",
            "scope": [
                "comment.line.documentation",
                "comment.block.documentation",
                "keyword.codetag.notation"
            ],
            "settings": { "foreground": "#ff005b", "fontStyle": "bold italic" }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "meta.string"
            ],
            "settings": { "foreground": "#d3ff3b" }
        },
        {
            "name": "String Escape / Regex",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#f92672" }
        },
        {
            "name": "Character literal",
            "scope": ["string.quoted.single.char", "constant.character"],
            "settings": { "foreground": "#ffff00" }
        },
        {
            "name": "Number / Float",
            "scope": [
                "constant.numeric",
                "constant.numeric.float",
                "constant.numeric.integer"
            ],
            "settings": { "foreground": "#ff0080" }
        },
        {
            "name": "Boolean / Null",
            "scope": [
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "constant.language.nan",
                "constant.language.infinity"
            ],
            "settings": { "foreground": "#0184bc" }
        },
        {
            "name": "Constant (other)",
            "scope": ["constant", "constant.other", "support.constant"],
            "settings": { "foreground": "#ae81ff", "fontStyle": "bold" }
        },
        {
            "name": "Statement / Keyword Control",
            "scope": [
                "keyword.control",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.flow"
            ],
            "settings": { "foreground": "#f92672", "fontStyle": "bold" }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical",
                "storage.modifier"
            ],
            "settings": { "foreground": "#65d8ee", "fontStyle": "bold" }
        },
        {
            "name": "Storage Type (class, function, def, …)",
            "scope": ["storage.type", "storage"],
            "settings": { "foreground": "#87ff00", "fontStyle": "italic" }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace"
            ],
            "settings": { "foreground": "#ff4081" }
        },
        {
            "name": "Delimiter",
            "scope": ["punctuation.section", "punctuation.definition"],
            "settings": { "foreground": "#8f8f8f" }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function",
                "meta.function entity.name.function"
            ],
            "settings": { "foreground": "#63ff51" }
        },
        {
            "name": "Function Parameter",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#cccccc" }
        },
        {
            "name": "Identifier / Variable",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "support.variable",
                "meta.definition.variable variable"
            ],
            "settings": { "foreground": "#ff4081", "fontStyle": "bold" }
        },
        {
            "name": "Property",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key",
                "support.type.property-name"
            ],
            "settings": { "foreground": "#70f0f0" }
        },
        {
            "name": "Type",
            "scope": [
                "entity.name.type",
                "support.type",
                "meta.type",
                "storage.type.primitive"
            ],
            "settings": { "foreground": "#66d9ef" }
        },
        {
            "name": "Class (Structure)",
            "scope": [
                "entity.name.class",
                "support.class",
                "meta.class entity.name"
            ],
            "settings": { "foreground": "#70f0f0" }
        },
        {
            "name": "Typedef",
            "scope": [
                "entity.name.type.typedef",
                "meta.typealias entity.name.type"
            ],
            "settings": { "foreground": "#007dff" }
        },
        {
            "name": "Constant Language Alt",
            "scope": ["constant.language", "variable.language"],
            "settings": { "foreground": "#ae81ff" }
        },
        {
            "name": "Macro / Decorator",
            "scope": [
                "meta.preprocessor",
                "entity.name.function.decorator",
                "punctuation.definition.decorator",
                "meta.function.decorator"
            ],
            "settings": { "foreground": "#87ff00", "fontStyle": "bold" }
        },
        {
            "name": "PreProc / Include",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.other.import",
                "keyword.other.preprocessor"
            ],
            "settings": { "foreground": "#d3ff00" }
        },
        {
            "name": "Special character",
            "scope": ["constant.character.special"],
            "settings": { "foreground": "#f92672", "fontStyle": "bold" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": { "foreground": "#f92672", "fontStyle": "italic" }
        },
        {
            "name": "Tag Punctuation",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end"
            ],
            "settings": { "foreground": "#8f8f8f" }
        },
        {
            "name": "HTML/JSX Attribute",
            "scope": [
                "entity.other.attribute-name",
                "meta.attribute.entity.other.attribute-name"
            ],
            "settings": { "foreground": "#ff4081" }
        },
        {
            "name": "CSS Property",
            "scope": ["support.type.property-name.css", "meta.property-name"],
            "settings": { "foreground": "#65d8ee" }
        },
        {
            "name": "CSS Value",
            "scope": [
                "support.constant.property-value.css",
                "meta.property-value"
            ],
            "settings": { "foreground": "#d3ff3b" }
        },
        {
            "name": "CSS Selector",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.name.tag.css"
            ],
            "settings": { "foreground": "#f92672", "fontStyle": "bold" }
        },
        {
            "name": "JSON Key",
            "scope": [
                "support.type.property-name.json",
                "meta.structure.dictionary.json string.quoted.double.json"
            ],
            "settings": { "foreground": "#65d8ee" }
        },
        {
            "name": "Markdown heading",
            "scope": ["markup.heading", "entity.name.section.markdown"],
            "settings": { "foreground": "#ff0080", "fontStyle": "bold" }
        },
        {
            "name": "Markdown bold",
            "scope": ["markup.bold", "markup.bold markup.italic"],
            "settings": { "foreground": "#cccccc", "fontStyle": "bold" }
        },
        {
            "name": "Markdown italic",
            "scope": ["markup.italic", "markup.italic markup.bold"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markdown inline code",
            "scope": ["markup.inline.raw", "markup.raw"],
            "settings": { "foreground": "#d3ff3b" }
        },
        {
            "name": "Markdown link text",
            "scope": [
                "string.other.link.title.markdown",
                "markup.underline.link"
            ],
            "settings": { "foreground": "#448aff", "fontStyle": "bold" }
        },
        {
            "name": "Diff Added",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#87ff00" }
        },
        {
            "name": "Diff Removed",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#ff005b" }
        },
        {
            "name": "Diff Changed",
            "scope": ["markup.changed"],
            "settings": { "foreground": "#65d8ee" }
        },
        {
            "name": "Invalid / Error",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#f20052", "fontStyle": "bold underline" }
        }
    ]
}
