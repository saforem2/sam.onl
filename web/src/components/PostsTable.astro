---
import { getCollection } from 'astro:content'

const docs = await getCollection('docs')

const posts = docs
    .filter((doc) => {
        const [category] = doc.id.split('/')
        if (category !== 'posts') return false
        // Skip the posts index itself
        if (doc.id === 'posts') return false
        // Skip drafts
        if (doc.id.startsWith('posts/drafts')) return false
        return true
    })
    .map((doc) => {
        const path = '/' + doc.id
        const date = doc.data.date
            ? doc.data.date.toISOString().split('T')[0]
            : ''
        return {
            title: doc.data.title,
            date,
            path,
            description: doc.data.description || '',
        }
    })
    .sort((a, b) => {
        if (a.date && b.date) return b.date.localeCompare(a.date)
        if (a.date) return -1
        if (b.date) return 1
        return a.title.localeCompare(b.title)
    })
---

<table class="posts-table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Title</th>
        </tr>
    </thead>
    <tbody>
        {
            posts.map((post) => (
                <tr>
                    <td>{post.date && post.date}</td>
                    <td>
                        <a href={post.path}>{post.title}</a>
                    </td>
                </tr>
            ))
        }
    </tbody>
</table>

<style>
    .posts-table {
        --table-border-width: 1px;
        --table-border-color: var(--foreground1);
        width: 100%;
        max-width: 100%;
        /* table-layout: auto lets columns size by content but bound by
           the 100% above, so the Title cell wraps instead of forcing
           horizontal scroll on narrow viewports. */
        table-layout: auto;
    }
    /* Date column: short, fixed-width-ish content (YYYY/MM/DD). Hold
       it on one line so it doesn't waste vertical space, and let the
       Title cell soak up the rest. */
    .posts-table td:first-child,
    .posts-table th:first-child {
        white-space: nowrap;
        width: 1%;
    }
    /* Title cell: allow line wrapping (default), and break long
       URL-ish tokens at any character so they don't push the column
       wide on narrow viewports. */
    .posts-table td:nth-child(2) {
        overflow-wrap: anywhere;
        word-break: break-word;
    }
    .posts-table a {
        text-decoration: none;
    }
</style>
