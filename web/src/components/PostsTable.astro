---
import { getCollection } from 'astro:content'

const docs = await getCollection('docs')

const posts = docs
    .filter((doc) => {
        const [category] = doc.id.split('/')
        if (category !== 'posts') return false
        // Skip the posts index itself
        if (doc.id === 'posts') return false
        // Skip drafts
        if (doc.id.startsWith('posts/drafts')) return false
        return true
    })
    .map((doc) => {
        const path = '/' + doc.id
        const date = doc.data.date
            ? doc.data.date.toISOString().split('T')[0]
            : ''
        return {
            title: doc.data.title,
            date,
            path,
            description: doc.data.description || '',
        }
    })
    .sort((a, b) => {
        if (a.date && b.date) return b.date.localeCompare(a.date)
        if (a.date) return -1
        if (b.date) return 1
        return a.title.localeCompare(b.title)
    })
---

<table class="posts-table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Title</th>
        </tr>
    </thead>
    <tbody>
        {
            posts.map((post) => (
                <tr>
                    <td>{post.date && post.date}</td>
                    <td>
                        <a href={post.path}>{post.title}</a>
                    </td>
                </tr>
            ))
        }
    </tbody>
</table>

<style>
    .posts-table {
        --table-border-width: 1px;
        --table-border-color: var(--foreground1);
        width: 100%;
        max-width: 100%;
        /* table-layout: fixed forces the browser to size columns from
           the first row's cell widths instead of measuring every
           cell's max-content. Without this on mobile the Title
           column's max-content (a long post title) pushed the whole
           table past the viewport — overflow-wrap then never had a
           chance to fire because the column was already sized to fit
           the unwrapped string. fixed + the col widths below let the
           Title cell wrap on the first too-long word. */
        table-layout: fixed;
    }
    /* Date column: short, fixed-width-ish content (YYYY/MM/DD). 11ch
       fits the format with a hair of padding; no wrapping. */
    .posts-table td:first-child,
    .posts-table th:first-child {
        white-space: nowrap;
        width: 11ch;
    }
    /* Title cell: take whatever's left and wrap inside it; break long
       URL-ish tokens at any character so they don't bleed past the
       column edge. */
    .posts-table td:nth-child(2),
    .posts-table th:nth-child(2) {
        width: auto;
        overflow-wrap: anywhere;
        word-break: break-word;
    }
    .posts-table a {
        text-decoration: none;
    }
</style>
