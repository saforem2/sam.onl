---
import { getCollection } from 'astro:content'

const docs = await getCollection('docs')

const posts = docs
    .filter((doc) => {
        const [category] = doc.id.split('/')
        if (category !== 'posts') return false
        // Skip the posts index itself
        if (doc.id === 'posts') return false
        // Skip drafts
        if (doc.id.startsWith('posts/drafts')) return false
        return true
    })
    .map((doc) => {
        const path = '/' + doc.id
        const date = doc.data.date
            ? doc.data.date.toISOString().split('T')[0]
            : ''
        return {
            title: doc.data.title,
            date,
            path,
            description: doc.data.description || '',
        }
    })
    .sort((a, b) => {
        if (a.date && b.date) return b.date.localeCompare(a.date)
        if (a.date) return -1
        if (b.date) return 1
        return a.title.localeCompare(b.title)
    })
---

<table class="posts-table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Title</th>
        </tr>
    </thead>
    <tbody>
        {
            posts.map((post) => (
                <tr>
                    <td>{post.date && post.date}</td>
                    <td>
                        <a href={post.path}>{post.title}</a>
                    </td>
                </tr>
            ))
        }
    </tbody>
</table>

<style>
    /* Matches the talks-table styling (talks/index.mdx): left-aligned
       header band, zebra-striped rows, dimmed date column, and vertical
       breathing room. Width + mobile horizontal scroll come from the
       shared .table-scroll-wrapper machinery (Doc.astro + global.css), same
       as the talks table — so no table-layout / overflow-wrap overrides
       here. */
    .posts-table {
        margin-block: 1lh;
        border-collapse: collapse;
    }
    .posts-table th,
    .posts-table td {
        padding: 0.25lh 1ch;
        vertical-align: top;
    }
    .posts-table th {
        text-align: left;
        background-color: var(--background1);
    }
    /* Date column: 14ch matches the talks table's Date column exactly so
       the two align. No wrapping; dimmed to --foreground2 like talks. */
    .posts-table td:first-child,
    .posts-table th:first-child {
        white-space: nowrap;
        width: 14ch;
    }
    .posts-table td:first-child {
        color: var(--foreground2);
    }
    .posts-table tbody tr:nth-child(even) {
        background-color: oklch(from var(--background1) l c h / 0.5);
    }
    .posts-table a {
        text-decoration: none;
    }
</style>
