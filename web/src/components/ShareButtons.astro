---
interface Props {
    title: string
    url: string
}

const { title, url } = Astro.props as Props
---

<span class="share-buttons">
    <button
        class="share-btn share-btn-copy"
        is-="badge"
        size-="small"
        data-action="copy"
        data-url={url}
        title="Copy link"
        aria-label="Copy link">&#xf0c5;</button
    >
    <a
        class="share-btn share-btn-twitter"
        is-="badge"
        size-="small"
        href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`}
        target="_blank"
        rel="noopener noreferrer"
        title="Share on Twitter/X"
        aria-label="Share on Twitter/X">&#xf099;</a
    >
    <a
        class="share-btn share-btn-bluesky"
        is-="badge"
        size-="small"
        href={`https://bsky.app/intent/compose?text=${encodeURIComponent(`${title} ${url}`)}`}
        target="_blank"
        rel="noopener noreferrer"
        title="Share on Bluesky"
        aria-label="Share on Bluesky">&#xe28e;</a
    >
</span>

<style>
    .share-buttons {
        display: inline-flex;
        align-items: center;
        gap: 0.5ch;
    }

    .share-btn {
        font-family: var(--font-family);
        font-size: 1em;
        box-sizing: border-box;
        width: 3ch;
        padding: 0;
        color: var(--foreground2);
        background: none;
        border: 1px solid transparent;
        border-radius: 0;
        cursor: pointer;
        text-decoration: none;
        text-align: center;
        justify-content: center;
        opacity: 0.6;
        --chip-accent: var(--foreground2);
        transition:
            opacity 0.1s linear,
            color 0.1s linear,
            background-color 0.1s linear,
            border-color 0.1s linear,
            transform 0.1s ease-out,
            box-shadow 0.1s ease-out;

        &:hover,
        &:focus-visible {
            opacity: 1;
            color: var(--foreground0);
            transform: translate(-1px, -1px);
            box-shadow: 2px 2px 0 0 var(--chip-accent);
        }
        &:active {
            transform: translate(0, 0);
            box-shadow: 1px 1px 0 0 var(--chip-accent);
        }
    }

    /* Tinted-badge style (kill the gradient + pseudo fills so the
       background-color paints uniformly). */
    .share-btn-copy,
    .share-btn-twitter,
    .share-btn-bluesky {
        background-image: none;
        background-color: var(--badge-color);
        color: var(--badge-text);
        opacity: 1;

        &::before,
        &::after {
            background-color: transparent;
        }
    }

    .share-btn-copy {
        --chip-accent: var(--pink);
        --badge-color: color-mix(in srgb, var(--background0), var(--pink) 18%);
        --badge-text: var(--pink);

        &:hover,
        &:focus-visible {
            --badge-color: color-mix(
                in srgb,
                var(--background0),
                var(--pink) 30%
            );
            color: var(--pink);
            border-color: var(--pink);
        }
    }

    .share-btn-twitter {
        --twitter: #1da1f2;
        --chip-accent: var(--twitter);
        --badge-color: color-mix(
            in srgb,
            var(--background0),
            var(--twitter) 18%
        );
        --badge-text: var(--twitter);

        &:hover,
        &:focus-visible {
            --badge-color: color-mix(
                in srgb,
                var(--background0),
                var(--twitter) 30%
            );
            color: var(--twitter);
            border-color: var(--twitter);
        }
    }

    .share-btn-bluesky {
        --bluesky: #0085ff;
        --chip-accent: var(--bluesky);
        --badge-color: color-mix(
            in srgb,
            var(--background0),
            var(--bluesky) 18%
        );
        --badge-text: var(--bluesky);

        &:hover,
        &:focus-visible {
            --badge-color: color-mix(
                in srgb,
                var(--background0),
                var(--bluesky) 30%
            );
            color: var(--bluesky);
            border-color: var(--bluesky);
        }
    }
</style>

<script>
    const copyButtons = document.querySelectorAll(
        '.share-btn[data-action="copy"]',
    )
    for (const btn of copyButtons) {
        btn.addEventListener('click', async () => {
            const url = (btn as HTMLElement).dataset.url
            if (!url) return
            const original = btn.textContent
            const originalTitle = btn.getAttribute('title')
            try {
                await navigator.clipboard.writeText(url)
                btn.textContent = '\uf00c'
                btn.setAttribute('title', 'Copied!')
            } catch {
                btn.textContent = '\uf00d'
                btn.setAttribute('title', 'Copy failed')
            }
            setTimeout(() => {
                btn.textContent = original
                if (originalTitle !== null)
                    btn.setAttribute('title', originalTitle)
            }, 2000)
        })
    }
</script>
