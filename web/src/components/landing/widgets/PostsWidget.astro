---
import { getCollection } from 'astro:content'

const docs = await getCollection('docs')
const posts = docs
    .filter((doc) => doc.id.startsWith('posts/'))
    .filter((doc) => !doc.data.draft)
    .filter((doc) => doc.data.date)
    .sort((a, b) => {
        const da = a.data.date ? new Date(a.data.date).getTime() : 0
        const db = b.data.date ? new Date(b.data.date).getTime() : 0
        return db - da
    })
    .slice(0, 10)

function formatDate(date: Date): string {
    return new Intl.DateTimeFormat('en-US', {
        month: 'short',
        day: 'numeric',
    }).format(date)
}
---

<column box-="square" pad-="2 2" gap-="0" class="posts-widget" tabindex="0">
    <span is-="badge" variant-="blue" class="pw-title"
        >&#xf0219; recent [<a href="/posts">posts</a>]</span
    >
    <column gap-="0" class="pw-list">
        {
            posts.map((post) => (
                <a href={`/${post.id}`} class="pw-item">
                    <span class="pw-date">
                        {post.data.date
                            ? formatDate(new Date(post.data.date))
                            : ''}
                    </span>
                    <span class="pw-name">{post.data.title}</span>
                </a>
            ))
        }
    </column>
</column>

<style>
    .posts-widget {
        gap: 1lh;
        overflow: hidden;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .pw-title {
        background-image: none;
        --badge-text: none;
        --badge-color: none;
        line-height: 1.5;

        --color: var(--blue);
        color: var(--color);
        background-color: oklch(
            from var(--color) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
        a {
            color: var(--color);
            font-weight: bold;
        }
    }

    .pw-list {
        gap: 0;
        flex: 1;
        overflow-y: auto;
        min-height: 0;
        scrollbar-width: thin;
        scrollbar-color: var(--foreground2) transparent;
    }

    .pw-item {
        display: flex;
        gap: 2ch;
        align-items: baseline;
        line-height: 2;
        text-decoration: none;
        color: var(--foreground1);
        white-space: nowrap;
        flex-shrink: 0;

        &:hover {
            color: var(--blue);
        }
    }

    .pw-date {
        color: var(--foreground2);
        flex-shrink: 0;
        width: 7ch;
    }

    .pw-name {
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>
