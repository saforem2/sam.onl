---
import { getCollection } from 'astro:content'

const docs = await getCollection('docs')
const posts = docs
    .filter((doc) => doc.id.startsWith('posts/'))
    .filter((doc) => !doc.data.draft)
    .filter((doc) => doc.data.date)
    .sort((a, b) => {
        const da = a.data.date ? new Date(a.data.date).getTime() : 0
        const db = b.data.date ? new Date(b.data.date).getTime() : 0
        return db - da
    })
    .slice(0, 20)

function formatDate(date: Date): string {
    const y = String(date.getFullYear()).slice(-2)
    const m = String(date.getMonth() + 1).padStart(2, '0')
    const d = String(date.getDate()).padStart(2, '0')
    return `${y}/${m}/${d}`
}

function stripEmoji(text: string): string {
    return text.replace(
        /^[\p{Emoji_Presentation}\p{Extended_Pictographic}️‍]+\s*/gu,
        '',
    )
}
---

<column box-="square" pad-="2 1" gap-="0" class="posts-widget" tabindex="0">
    <span is-="badge" variant-="blue" class="pw-title"
        >&#xf02d; <a href="/posts" class="widget-link"><u>p</u>osts</a></span
    >
    <column gap-="0" class="pw-list">
        {
            posts.map((post) => (
                <a href={`/${post.id}`} class="pw-item">
                    <span class="pw-date">
                        {post.data.date
                            ? formatDate(new Date(post.data.date))
                            : ''}
                    </span>
                    <span class="pw-name">{stripEmoji(post.data.title)}</span>
                </a>
            ))
        }
    </column>
</column>

<style>
    .posts-widget {
        gap: 1lh;
        overflow: hidden;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .pw-title {
        background-image: none;
        --badge-text: none;
        --badge-color: none;
        /* line-height: 1.5; */

        --color: var(--blue);
        color: var(--color);
        background-color: oklch(
            from var(--color) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
        a {
            color: var(--color);
            font-weight: bold;
        }
    }

    .pw-list {
        gap: 0;
        flex: 1;
        overflow-y: auto;
        min-height: 0;
        scrollbar-width: thin;
        scrollbar-color: var(--foreground2) transparent;
        margin-block-start: -0.5lh;
    }

    .pw-item {
        display: flex;
        gap: 2ch;
        align-items: baseline;
        /* line-height: 2; */
        text-decoration: none;
        color: var(--foreground1);
        white-space: nowrap;
        flex-shrink: 0;
        overflow: hidden;
        min-width: 0;

        &:hover {
            color: var(--blue);
        }
    }

    .pw-date {
        color: var(--foreground2);
        flex-shrink: 0;
        width: 10ch;
    }

    .pw-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
    }
</style>
