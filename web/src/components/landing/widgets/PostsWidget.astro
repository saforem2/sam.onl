---
import { getCollection } from 'astro:content'

const docs = await getCollection('docs')
const posts = docs
    .filter((doc) => doc.id.startsWith('posts/'))
    .filter((doc) => !doc.data.draft)
    .filter((doc) => doc.data.date)
    .sort((a, b) => {
        const da = a.data.date ? new Date(a.data.date).getTime() : 0
        const db = b.data.date ? new Date(b.data.date).getTime() : 0
        return db - da
    })
    .slice(0, 20)

function formatDate(date: Date): string {
    const y = String(date.getFullYear()).slice(-2)
    const m = String(date.getMonth() + 1).padStart(2, '0')
    return `${y}/${m}`
}

function stripEmoji(text: string): string {
    return text.replace(
        /^[\p{Emoji_Presentation}\p{Extended_Pictographic}️‍]+\s*/gu,
        '',
    )
}
---

<column box-="square" pad-="2 1" gap-="0" class="posts-widget" tabindex="0">
    <span is-="badge" variant-="blue" class="pw-title"
        >&#xf02d; <a href="/posts" class="widget-link"><u>p</u>osts</a></span
    >
    <column gap-="0" class="pw-list">
        {
            posts.map((post) => (
                <a href={`/${post.id}`} class="pw-item">
                    <span class="pw-date">
                        {post.data.date
                            ? formatDate(new Date(post.data.date))
                            : ''}
                    </span>
                    <span class="pw-name">{stripEmoji(post.data.title)}</span>
                </a>
            ))
        }
    </column>
</column>

<style>
    .posts-widget {
        gap: 1lh;
        /* clip (not hidden) + a clip margin so the card still clips its
           scrolling list, but the hover/scroll-active hard-offset shadow
           can paint past the edge into the grid gap instead of being cut. */
        overflow: clip;
        overflow-clip-margin: 4px;
        min-height: 0;
        display: flex;
        flex-direction: column;
        /* Flush 1px border instead of box-="square"'s inset ::before, so the
           grid's edge-drawn hover/active shadow hugs the border. */
        border: 1px solid var(--foreground3);
        padding: 0.5lh 1ch;
    }
    .posts-widget::before {
        content: none !important;
    }

    .pw-title {
        background-image: none;
        --badge-text: none;
        --badge-color: none;
        /* line-height: 1.5; */

        --color: var(--blue);
        color: var(--color);
        background-color: oklch(
            from var(--color) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
        a {
            color: var(--color);
            font-weight: bold;
        }
    }

    .pw-list {
        gap: 0;
        flex: 1;
        overflow-y: auto;
        min-height: 0;
        scrollbar-width: thin;
        scrollbar-color: var(--foreground2) transparent;
        margin-block-start: -0.5lh;
    }

    .pw-item {
        display: flex;
        gap: 1ch;
        align-items: baseline;
        text-decoration: none;
        color: var(--foreground1);
        white-space: nowrap;
        flex-shrink: 0;
        overflow: hidden;
        min-width: 0;

        &:hover {
            color: var(--blue);
        }
    }

    .pw-date {
        color: var(--foreground2);
        flex-shrink: 0;
        /* Date format is YY/MM (5 chars). Pin the column to the glyph
           width so the title starts immediately after with a single
           1ch gap from .pw-item — no extra trailing padding inside the
           date cell. */
        width: 5ch;
    }

    .pw-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
    }
</style>
