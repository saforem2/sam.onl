---
import { getCollection } from 'astro:content'

const docs = await getCollection('docs')
const talks = docs
    .filter((doc) => doc.id.startsWith('talks/'))
    .filter((doc) => !doc.id.endsWith('talks'))
    .filter((doc) => doc.data.date)
    .sort((a, b) => {
        const da = a.data.date ? new Date(a.data.date).getTime() : 0
        const db = b.data.date ? new Date(b.data.date).getTime() : 0
        return db - da
    })
    .slice(0, 20)

function formatDate(date: Date): string {
    const y = String(date.getFullYear()).slice(-2)
    const m = String(date.getMonth() + 1).padStart(2, '0')
    return `${y}/${m}`
}
---

<column box-="square" pad-="2 1" gap-="0" class="talks-widget" tabindex="0">
    <span is-="badge" variant-="orange" class="tw-title"
        >&#xf19d; <a href="/talks" class="widget-link"><u>t</u>alks</a></span
    >
    <column gap-="0" class="tw-list">
        {
            talks.map((talk) => (
                <a href={`/${talk.id}`} class="tw-item">
                    <span class="tw-date">
                        {talk.data.date
                            ? formatDate(new Date(talk.data.date))
                            : ''}
                    </span>
                    <span class="tw-name">{talk.data.title}</span>
                </a>
            ))
        }
    </column>
</column>

<style>
    .talks-widget {
        gap: 1lh;
        /* clip (not hidden) + a clip margin so the card still clips its
           scrolling list, but the hover/scroll-active hard-offset shadow
           can paint past the edge into the grid gap instead of being cut. */
        overflow: clip;
        overflow-clip-margin: 4px;
        min-height: 0;
        display: flex;
        flex-direction: column;
        /* Flush 1px border instead of box-="square"'s inset ::before, so the
           grid's edge-drawn hover/active shadow hugs the border. */
        border: 1px solid var(--foreground3);
        padding: 0.5lh 1ch;
    }
    .talks-widget::before {
        content: none !important;
    }

    .tw-title {
        background-image: none;
        --badge-text: none;
        --badge-color: none;
        --color: var(--orange);
        color: var(--color);
        background-color: oklch(
            from var(--color) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
        a {
            color: var(--color);
            font-weight: bold;
        }
    }

    .tw-list {
        gap: 0;
        flex: 1;
        overflow-y: auto;
        min-height: 0;
        scrollbar-width: thin;
        scrollbar-color: var(--foreground2) transparent;
        margin-block-start: -0.5lh;
    }

    .tw-item {
        display: flex;
        gap: 1ch;
        align-items: baseline;
        text-decoration: none;
        color: var(--foreground1);
        white-space: nowrap;
        flex-shrink: 0;

        &:hover {
            color: var(--blue);
        }
    }

    .tw-date {
        color: var(--foreground2);
        flex-shrink: 0;
        width: 5ch;
    }

    .tw-name {
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>
