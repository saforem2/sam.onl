<column box-="square" pad-="2 1" gap-="0" class="work-widget" tabindex="0">
    <span is-="badge" variant-="green" class="ww-title"
        >&#xf0b1; <a
            href="https://scholar.google.com/citations?user=vV_1zDwAAAAJ"
            target="_blank"
            class="widget-link"><u>w</u>ork</a
        ></span
    >
    <column gap-="0" class="ww-list">
        {
            works.map((w) => (
                <a href={w.href} target="_blank" class="ww-item">
                    <span class="ww-year">{w.year}</span>
                    <span class="ww-name">
                        {w.title}
                        {w.badge && <span class="ww-badge">{w.badge}</span>}
                    </span>
                </a>
            ))
        }
    </column>
</column>

<style>
    .work-widget {
        gap: 1lh;
        /* clip (not hidden) + a clip margin so the card still clips its
           scrolling list, but the hover/scroll-active hard-offset shadow
           can paint past the edge into the grid gap instead of being cut. */
        overflow: clip;
        overflow-clip-margin: 4px;
        min-height: 0;
        display: flex;
        flex-direction: column;
        /* Replace WebTUI's box-="square" inset pseudo-border with a plain
           1px border on all four edges. The inset ::before border (0.5ch/
           0.5lh in from the card edge) left the bottom/right sides looking
           faded/cut where the scrolling list met them; a flush 1px border is
           uniform on every side. */
        border: 1px solid var(--foreground3);
        padding: 0.5lh 1ch;
    }
    .work-widget::before {
        content: none !important;
    }

    .ww-title {
        background-image: none;
        --badge-text: none;
        --badge-color: none;
        /* line-height: 1.5; */

        --color: var(--green);
        color: var(--color);
        background-color: oklch(
            from var(--color) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
        a {
            color: var(--color);
            font-weight: bold;
        }
    }

    .ww-list {
        gap: 0;
        flex: 1;
        overflow-y: auto;
        min-height: 0;
        scrollbar-width: thin;
        scrollbar-color: var(--foreground2) transparent;
        margin-block-start: -0.5lh;
    }

    .ww-item {
        display: flex;
        gap: 1ch;
        align-items: baseline;
        text-decoration: none;
        color: var(--foreground1);
        white-space: nowrap;
        flex-shrink: 0;

        &:hover {
            color: var(--blue);
        }
    }

    .ww-year {
        color: var(--foreground2);
        flex-shrink: 0;
        width: 4ch;
    }

    .ww-name {
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ww-badge {
        color: var(--yellow);
        margin-left: 1ch;
        font-size: 0.85em;
    }
</style>
