---
type EntryNode = {
    name: string
    isDirectory: boolean
    className: string
    children: EntryNode[]
    hiddenCount: number
}

const expandedRootDirectories = new Set<string>(['posts', 'talks', 'webtui'])
const visibleExtensions = new Set<string>([
    '.astro',
    '.md',
    '.mdx',
    '.json',
    '.txt',
    '.xml',
])
const maxChildEntries = 12

// Build-time filesystem walk of src/pages to list every page path for the
// decorative file tree. This deliberately does NOT use `import.meta.glob`:
// a glob registers a dynamic-import module-graph edge from this widget to
// EVERY page, and Astro's CSS plugin walks importers *backward* (following
// dynamic importers too — core/build/plugins/graph.js concats
// info.dynamicImporters), so the glob made the landing page a "parent" of
// every scoped-component CSS module on the site and linked ~5 unrelated
// slide/doc CSS chunks into the landing critical path. FileTree only ever
// reads the path list (never imports the modules), so a plain fs read gives
// the identical output with zero graph edges. Anchor on process.cwd()
// (= the `web/` workspace at build time), NOT import.meta.url — a bundled
// import.meta.url resolves into dist/ (the resolveSourceFile footgun).
import { readdirSync } from 'node:fs'
import { join } from 'node:path'

const pagesRoot = join(process.cwd(), 'src/pages')
const pageModuleKeys: string[] = []
const walkPages = (dir: string, prefix: string): void => {
    for (const dirent of readdirSync(dir, { withFileTypes: true })) {
        const rel = prefix ? `${prefix}/${dirent.name}` : dirent.name
        if (dirent.isDirectory()) {
            walkPages(`${dir}/${dirent.name}`, rel)
        } else if (
            /\.(astro|md|mdx)$/.test(dirent.name) &&
            rel !== 'index.astro'
        ) {
            pageModuleKeys.push(rel)
        }
    }
}
walkPages(pagesRoot, '')

const syntheticPaths = [
    '_redirects',
    'index.astro',
    'index.xml',
    'listings.json',
    'robots.txt',
    'search.json',
    'sitemap.xml',
    'posts/index.xml',
]
const relativePaths = Array.from(
    new Set([...pageModuleKeys, ...syntheticPaths]),
).filter((path) => path.length > 0 && path !== 'landing.mdx copy')

const extensionOf = (name: string): string => {
    const lastDot = name.lastIndexOf('.')
    return lastDot >= 0 ? name.slice(lastDot) : ''
}

const isDirectoryPath = (candidate: string): boolean =>
    relativePaths.some((path) => path.startsWith(`${candidate}/`))

const isVisibleFile = (name: string): boolean => {
    if (name === '_redirects') return true
    return visibleExtensions.has(extensionOf(name))
}

const classifyEntry = (name: string, isDirectory: boolean): string => {
    if (isDirectory) return 'folder'

    const extension = extensionOf(name)
    if (extension === '.md' || extension === '.mdx') return 'markdown'
    if (extension === '.astro') return 'astro'
    if (extension === '.json' || extension === '.xml') return 'config'
    return 'file'
}

const sortEntries = (a: EntryNode, b: EntryNode): number => {
    if (a.isDirectory && !b.isDirectory) return -1
    if (!a.isDirectory && b.isDirectory) return 1
    return a.name.localeCompare(b.name)
}

const rootNames = Array.from(
    new Set(relativePaths.map((path) => path.split('/')[0]).filter(Boolean)),
)

const rootEntries: EntryNode[] = rootNames
    .map((rootName): EntryNode | null => {
        const rootIsDirectory = isDirectoryPath(rootName)

        if (!rootIsDirectory) {
            if (!isVisibleFile(rootName)) return null

            return {
                name: rootName,
                isDirectory: false,
                className: classifyEntry(rootName, false),
                children: [],
                hiddenCount: 0,
            }
        }

        const rootEntry: EntryNode = {
            name: rootName,
            isDirectory: true,
            className: 'folder',
            children: [],
            hiddenCount: 0,
        }

        if (!expandedRootDirectories.has(rootName)) return rootEntry

        const prefix = `${rootName}/`
        const childNames = Array.from(
            new Set(
                relativePaths
                    .filter((path) => path.startsWith(prefix))
                    .map((path) => path.slice(prefix.length).split('/')[0])
                    .filter(Boolean),
            ),
        )

        const childEntries = childNames
            .map((childName): EntryNode | null => {
                const childPath = `${rootName}/${childName}`
                const childIsDirectory = isDirectoryPath(childPath)

                if (!childIsDirectory && !isVisibleFile(childName)) return null

                return {
                    name: childName,
                    isDirectory: childIsDirectory,
                    className: classifyEntry(childName, childIsDirectory),
                    children: [],
                    hiddenCount: 0,
                }
            })
            .filter((entry): entry is EntryNode => entry !== null)
            .sort(sortEntries)

        rootEntry.children = childEntries.slice(0, maxChildEntries)
        rootEntry.hiddenCount = Math.max(
            childEntries.length - rootEntry.children.length,
            0,
        )

        return rootEntry
    })
    .filter((entry): entry is EntryNode => entry !== null)
    .sort(sortEntries)
---

<column box-="square" class="widget" pad-="2 1" id="filetree-widget">
    <span class="tree-title"
        ><span class="folder-icon">&#xf07b;</span> ~/samf.sh/web/src/pages</span
    >
    <ul marker-="open tree">
        {
            rootEntries.map((entry) => (
                <li class={entry.className}>
                    {entry.isDirectory ? (
                        <span class="folder-icon">&#xf07b;</span>
                    ) : (
                        <span class="file-icon">&#xe60d;</span>
                    )}{' '}
                    {entry.name}
                    {entry.children.length > 0 && (
                        <ul marker-="open tree">
                            {entry.children.map((child) => (
                                <li class={child.className}>
                                    {child.isDirectory ? (
                                        <span class="folder-icon">
                                            &#xf07b;
                                        </span>
                                    ) : (
                                        <span class="file-icon">&#xe60d;</span>
                                    )}{' '}
                                    {child.name}
                                </li>
                            ))}
                            {entry.hiddenCount > 0 && (
                                <li class="more">… {entry.hiddenCount} more</li>
                            )}
                        </ul>
                    )}
                </li>
            ))
        }
    </ul>
</column>

<style>
    #filetree-widget {
        grid-column: 1;
        grid-row: 2 / 5;
    }

    .tree-title {
        color: var(--blue);
        display: inline-block;
        height: 1lh;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    ul {
        overflow: hidden;
    }

    ul li::before {
        color: var(--foreground2);
    }

    .folder {
        color: var(--blue);
    }

    .markdown {
        color: var(--green);
    }

    .astro {
        color: var(--sapphire);
    }

    .config {
        color: var(--mauve);
    }

    .file {
        color: var(--foreground1);
    }

    .more {
        color: var(--foreground2);
        font-style: italic;
    }

    .folder-icon {
        color: var(--blue);
    }

    .file-icon {
        color: var(--sapphire);
    }
</style>
