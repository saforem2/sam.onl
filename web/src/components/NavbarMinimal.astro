---
import Filter from '@/components/Filter.astro'
---

<nav id="top-navbar">
    <a href="/" id="home-link"></a>
    <span id="nav-spacer"></span>
    <span id="nav-right">
        <button id="theme-button"></button>
        <a
            id="github-button"
            href="https://github.com/saforem2/sam.onl"
            target="_blank"></a
        >
        <a id="rss-button" href="/rss.xml" target="_blank"></a>
        <button id="search-button"></button>
    </span>
    <details id="nav-dropdown">
        <summary></summary>
        <div class="nav-dropdown-content">
            <a href="/"> home</a>
            <a href="/posts"> posts</a>
            <a href="/talks">8 talks</a>
            <a href="/landing"> more</a>
            <a href="https://github.com/saforem2/sam.onl" target="_blank"
                > github</a
            >
            <a href="/rss.xml" target="_blank"> rss</a>
            <button id="theme-button-mobile"> theme</button>
        </div>
    </details>
</nav>
<Filter />

<style>
    nav {
        display: flex;
        align-items: stretch;
        gap: 0;
        height: 1lh;
        line-height: 1lh;
        white-space: nowrap;
        max-width: 100%;
        overflow: hidden;
        /* Slightly smaller than body type — the nerd-font icons
           render larger at the same em-size than text glyphs, so a
           one-step shrink reads as proportional to the body. */
        font-size: 0.85em;
        /* Float in the top-right corner of the page, like the old vim
           island. Anchored to the #intro container (which is
           position: relative) so it stays inside the page bounds. */
        position: absolute;
        /* JS sets --navbar-left and --navbar-top to align with the
           #widgets-grid's left edge and roughly halfway between the
           top of the page and the grid's top. */
        top: var(--navbar-top, 2lh);
        left: var(--navbar-left, 1ch);
        z-index: 20;
        min-width: 0;
        width: max-content;
        background-color: var(--background1);
        border: 1px solid var(--foreground2);
        /* TUI hard-offset shadow only when the navbar is being interacted
           with — keeps the resting state minimal but signals focus. */
        transition: box-shadow 100ms linear;
        &:hover,
        &:focus-within {
            box-shadow: 2px 2px 0 0 var(--foreground0, #000);
        }

        :is(a[href], button:not([disabled])) {
            position: relative;
            outline: none;
            transition:
                background-color 100ms linear,
                color 100ms linear;
        }

        :is(a[href], button:not([disabled])):focus-visible,
        :is(a[href], button:not([disabled]))[data-vim-focused='true']:focus {
            background-color: var(--focus-bg-strong);
            color: var(--focus-fg);
            text-decoration: none;
        }
    }

    #home-link {
        all: unset;
        display: inline-flex;
        align-items: center;
        padding: 0 1ch;
        color: var(--foreground1);
        font-weight: bold;
        cursor: pointer;
        font-family: var(--font-family);
        text-decoration: none;
        border-right: 1px solid var(--background2);

        &:hover {
            background-color: var(--background2);
        }
    }

    #nav-spacer {
        flex: 1;
    }

    #nav-right {
        display: flex;
        align-items: stretch;
        gap: 0;

        :is(a, button) {
            all: unset;
            display: inline-flex;
            align-items: center;
            padding: 0 1ch;
            color: var(--foreground3);
            cursor: pointer;
            font-family: var(--font-family);
            font-size: inherit;
            line-height: inherit;
            text-decoration: none;
            border-left: 1px solid var(--background2);
        }

        #theme-button:hover,
        #theme-button:focus-visible {
            background-color: oklch(from var(--blue) l c h / 0.15);
            color: var(--blue);
        }

        #github-button:hover,
        #github-button:focus-visible {
            background-color: oklch(from var(--purple) l c h / 0.15);
            color: var(--purple);
        }

        #rss-button:hover,
        #rss-button:focus-visible {
            background-color: oklch(from var(--orange) l c h / 0.15);
            color: var(--orange);
        }

        #search-button:hover,
        #search-button:focus-visible {
            background-color: oklch(from var(--green) l c h / 0.15);
            color: var(--green);
        }
    }

    #nav-dropdown {
        display: none;
    }

    @media (max-width: 768px) {
        #nav-right {
            display: none;
        }

        #nav-dropdown {
            display: block;

            summary {
                display: flex;
                align-items: center;
                padding: 0 1ch;
                cursor: pointer;
                list-style: none;
                color: var(--foreground2);
                border-left: 1px solid var(--background2);

                &::-webkit-details-marker {
                    display: none;
                }
            }

            .nav-dropdown-content {
                position: absolute;
                right: 0;
                top: 100%;
                display: flex;
                flex-direction: column;
                background: var(--background0);
                border: 1px solid var(--foreground2);
                box-shadow: 2px 2px 0 0 var(--foreground2);
                z-index: 30;
                min-width: 16ch;

                :is(a, button) {
                    padding: 0.25lh 2ch;
                    text-decoration: none;
                    color: var(--foreground1);
                    border: none;
                    background: none;
                    cursor: pointer;
                    font: inherit;
                    text-align: left;

                    &:hover {
                        background: var(--background1);
                    }
                }
            }
        }
    }
</style>

<script>
    import { isUserTyping } from '@/utils/vim'

    const searchDialog = document.getElementById(
        'search-dialog',
    ) as HTMLDialogElement
    const themeDialog = document.getElementById(
        'theme-dialog',
    ) as HTMLDialogElement

    const root = document.documentElement
    const themeStorageKey = 'webtui-theme'
    const themeDropdowns = Array.from(
        document.querySelectorAll('[data-theme-dropdown="true"]'),
    ) as HTMLElement[]
    const themeButtons = Array.from(
        document.querySelectorAll('[data-theme-option]'),
    ) as HTMLButtonElement[]

    const setTheme = (theme: string) => {
        if (root.getAttribute('data-webtui-theme') !== theme) {
            root.setAttribute('data-webtui-theme', theme)
        }

        themeDropdowns.forEach((dropdown) => {
            if (dropdown.getAttribute('data-value') !== theme) {
                dropdown.setAttribute('data-value', theme)
            }
        })

        themeButtons.forEach((button) => {
            const value = button.getAttribute('data-theme-option')
            const isActive = value === theme
            button.setAttribute('aria-selected', String(isActive))
            button.setAttribute('variant-', 'background1')
            button.setAttribute('data-active', String(isActive))
        })

        localStorage.setItem(themeStorageKey, theme)
    }

    const storedTheme = localStorage.getItem(themeStorageKey)
    if (storedTheme) {
        setTheme(storedTheme)
    } else {
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)')
            .matches
            ? 'custom-dark'
            : 'custom-light'
        setTheme(systemTheme)
    }

    themeDropdowns.forEach((dropdown) => {
        new MutationObserver(() => {
            const value = dropdown.getAttribute('data-value')
            if (value && root.getAttribute('data-webtui-theme') !== value) {
                setTheme(value)
            }
        }).observe(dropdown, {
            attributes: true,
            attributeFilter: ['data-value'],
        })
    })

    themeButtons.forEach((button) => {
        button.addEventListener('click', () => {
            const value = button.getAttribute('data-theme-option')
            if (!value) return
            setTheme(value)
            themeDialog.close()
        })
    })

    const focusThemeOption = () => {
        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                const active = themeDialog.querySelector(
                    '.theme-option[aria-selected="true"]',
                ) as HTMLElement | null
                ;(active ?? themeDialog.querySelector('.theme-option'))?.focus()
            })
        })
    }

    document.getElementById('theme-button')?.addEventListener('click', () => {
        themeDialog.showModal()
        focusThemeOption()
    })

    document
        .getElementById('theme-button-mobile')
        ?.addEventListener('click', () => {
            themeDialog.showModal()
            focusThemeOption()
        })

    document.getElementById('search-button')?.addEventListener('click', () => {
        searchDialog.showModal()
    })

    const navShortcuts: Record<string, string> = {
        p: '/posts',
        t: '/talks',
        m: '/more',
    }

    window.addEventListener('keydown', (e) => {
        if (isUserTyping()) return

        if (e.key === '/') {
            e.preventDefault()
            searchDialog.showModal()
            return
        }

        if (e.defaultPrevented) return
        const href = navShortcuts[e.key]
        if (href) {
            e.preventDefault()
            window.location.href = href
        }
    })
</script>

<script>
    /* Pin the floating navbar's left edge to #widgets-grid's left edge.
       The grid uses translate-based centering; matching that exactly in
       pure CSS is fragile across viewports, so we measure on load + on
       resize and write the value to --navbar-left. */
    function alignNavbar() {
        const navbar = document.getElementById('top-navbar')
        const grid = document.getElementById('widgets-grid')
        if (!navbar || !grid) return
        const gridRect = grid.getBoundingClientRect()
        const navHeight = navbar.getBoundingClientRect().height || 20
        const intro = document.getElementById('intro')
        const introRect = intro
            ? intro.getBoundingClientRect()
            : { top: 0, left: 0 }
        // Both --navbar-top and --navbar-left are interpreted relative
        // to the navbar's offsetParent (which is #intro — the closest
        // positioned ancestor). Subtract #intro's own top-left so the
        // numbers we hand back are local to that frame, not viewport-
        // absolute. Critical when the page has a sidebar pushing
        // #intro right of the viewport origin — without the subtract,
        // the navbar overshoots by exactly the sidebar's width.
        const left = gridRect.left - introRect.left
        // Sit 1lh above the grid top. nav's own height is 1lh, so the
        // navbar's bottom edge ends up exactly at gridTop - 1lh, and its
        // top edge at gridTop - 2lh. (1lh ≈ navHeight on this page.)
        const top = gridRect.top - introRect.top - navHeight * 2
        navbar.style.setProperty('--navbar-left', `${left}px`)
        navbar.style.setProperty('--navbar-top', `${top}px`)
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', alignNavbar)
    } else {
        alignNavbar()
    }
    window.addEventListener('resize', alignNavbar)
</script>
