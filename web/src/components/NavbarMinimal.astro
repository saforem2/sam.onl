---
import Filter from '@/components/Filter.astro'
---

<nav id="top-navbar">
    <a href="/" id="home-link"></a>
    <span id="nav-spacer"></span>
    <span id="nav-right">
        <a
            id="github-button"
            href="https://github.com/saforem2/sam.onl"
            target="_blank"></a
        >
        <a id="rss-button" href="/rss.xml" target="_blank"></a>
        <button id="search-button"></button>
    </span>
    <details id="nav-dropdown">
        <summary></summary>
        <div class="nav-dropdown-content">
            <a href="/"> home</a>
            <a href="/posts"> posts</a>
            <a href="/talks">8 talks</a>
            <a href="/landing"> more</a>
            <a href="https://github.com/saforem2/sam.onl" target="_blank"
                > github</a
            >
            <a href="/rss.xml" target="_blank"> rss</a>
        </div>
    </details>
</nav>
<Filter />

<style>
    nav {
        display: flex;
        align-items: stretch;
        /* Flush — chip borders touch so the bar reads as a continuous
           key row, matching the sidebar action chips on doc pages. */
        gap: 0;
        white-space: nowrap;
        max-width: 100%;
        font-size: 0.95em;
        /* Float and overlap the intro-widget's box-= top border. JS
           writes --navbar-top to land the bar's vertical midline on the
           border line. */
        position: absolute;
        top: var(--navbar-top, 2lh);
        left: var(--navbar-left, 1ch);
        z-index: 20;
        min-width: 0;
        width: max-content;
        background-color: transparent;
        border: none;
    }

    /* Shared keycap chip — mirrors .sidebar-action on doc pages so the
       two surfaces speak the same language. Opaque fill (color-mix, not
       alpha) so the intro-widget's box-= border behind the chip is
       visually cut where the chip overlays it. */
    nav :is(a[href], button:not([disabled])) {
        all: unset;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        padding: 0.2lh 0.75ch;
        min-width: 3ch;
        color: var(--foreground2);
        background-color: color-mix(
            in oklch,
            var(--background0),
            var(--foreground0) 5%
        );
        border: 1px solid
            color-mix(in oklch, var(--background0), var(--foreground0) 18%);
        cursor: pointer;
        font-family: var(--font-family);
        font-size: inherit;
        line-height: 1;
        text-decoration: none;
        --chip-accent: var(--foreground2);
        transition:
            color 0.1s linear,
            background-color 0.1s linear,
            border-color 0.1s linear,
            transform 0.1s ease-out,
            box-shadow 0.1s ease-out;
        position: relative;
    }

    /* Tactile lift on hover — match sidebar chip language. */
    nav :is(a[href], button:not([disabled])):hover,
    nav :is(a[href], button:not([disabled])):focus-visible,
    nav :is(a[href], button:not([disabled]))[data-vim-focused='true'] {
        color: var(--foreground0);
        transform: translate(-1px, -1px);
        box-shadow: 2px 2px 0 0 var(--chip-accent);
    }

    nav :is(a[href], button:not([disabled])):active {
        transform: translate(0, 0);
        box-shadow: 1px 1px 0 0 var(--chip-accent);
    }

    /* Per-button accent tint. */
    #home-link:hover,
    #home-link:focus-visible,
    #home-link[data-vim-focused='true'] {
        --chip-accent: var(--blue);
        background-color: color-mix(
            in oklch,
            var(--background0),
            var(--blue) 18%
        );
        border-color: var(--blue);
        color: var(--blue);
    }

    #home-link {
        font-weight: bold;
        color: var(--foreground1);
    }

    #nav-spacer {
        flex: 1;
    }

    #nav-right {
        display: flex;
        align-items: stretch;
        gap: 0;

        #github-button:hover,
        #github-button:focus-visible,
        #github-button[data-vim-focused='true'] {
            --chip-accent: #6e5494;
            background-color: color-mix(
                in oklch,
                var(--background0),
                #6e5494 18%
            );
            border-color: #6e5494;
            color: #6e5494;
        }

        #rss-button:hover,
        #rss-button:focus-visible,
        #rss-button[data-vim-focused='true'] {
            --chip-accent: var(--orange);
            background-color: color-mix(
                in oklch,
                var(--background0),
                var(--orange) 18%
            );
            border-color: var(--orange);
            color: var(--orange);
        }

        #search-button:hover,
        #search-button:focus-visible,
        #search-button[data-vim-focused='true'] {
            --chip-accent: var(--green);
            background-color: color-mix(
                in oklch,
                var(--background0),
                var(--green) 18%
            );
            border-color: var(--green);
            color: var(--green);
        }
    }

    #nav-dropdown {
        display: none;
    }

    @media (max-width: 768px) {
        #nav-right {
            display: none;
        }

        #nav-dropdown {
            display: block;

            summary {
                display: flex;
                align-items: center;
                padding: 0 1ch;
                cursor: pointer;
                list-style: none;
                color: var(--foreground2);
                border-left: 1px solid var(--background2);

                &::-webkit-details-marker {
                    display: none;
                }
            }

            .nav-dropdown-content {
                position: absolute;
                right: 0;
                top: 100%;
                display: flex;
                flex-direction: column;
                background: var(--background0);
                border: 1px solid var(--foreground2);
                box-shadow: 2px 2px 0 0 var(--foreground2);
                z-index: 30;
                min-width: 16ch;

                :is(a, button) {
                    padding: 0.25lh 2ch;
                    text-decoration: none;
                    color: var(--foreground1);
                    border: none;
                    background: none;
                    cursor: pointer;
                    font: inherit;
                    text-align: left;

                    &:hover {
                        background: var(--background1);
                    }
                }
            }
        }
    }
</style>

<script>
    import { isUserTyping } from '@/utils/vim'

    const searchDialog = document.getElementById(
        'search-dialog',
    ) as HTMLDialogElement
    const themeDialog = document.getElementById(
        'theme-dialog',
    ) as HTMLDialogElement

    const root = document.documentElement
    const themeStorageKey = 'webtui-theme'
    const themeDropdowns = Array.from(
        document.querySelectorAll('[data-theme-dropdown="true"]'),
    ) as HTMLElement[]
    const themeButtons = Array.from(
        document.querySelectorAll('[data-theme-option]'),
    ) as HTMLButtonElement[]

    const setTheme = (theme: string) => {
        if (root.getAttribute('data-webtui-theme') !== theme) {
            root.setAttribute('data-webtui-theme', theme)
        }

        themeDropdowns.forEach((dropdown) => {
            if (dropdown.getAttribute('data-value') !== theme) {
                dropdown.setAttribute('data-value', theme)
            }
        })

        themeButtons.forEach((button) => {
            const value = button.getAttribute('data-theme-option')
            const isActive = value === theme
            button.setAttribute('aria-selected', String(isActive))
            button.setAttribute('variant-', 'background1')
            button.setAttribute('data-active', String(isActive))
        })

        localStorage.setItem(themeStorageKey, theme)
    }

    const storedTheme = localStorage.getItem(themeStorageKey)
    if (storedTheme) {
        setTheme(storedTheme)
    } else {
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)')
            .matches
            ? 'custom-dark'
            : 'custom-light'
        setTheme(systemTheme)
    }

    themeDropdowns.forEach((dropdown) => {
        new MutationObserver(() => {
            const value = dropdown.getAttribute('data-value')
            if (value && root.getAttribute('data-webtui-theme') !== value) {
                setTheme(value)
            }
        }).observe(dropdown, {
            attributes: true,
            attributeFilter: ['data-value'],
        })
    })

    themeButtons.forEach((button) => {
        button.addEventListener('click', () => {
            const value = button.getAttribute('data-theme-option')
            if (!value) return
            setTheme(value)
            themeDialog.close()
        })
    })

    document.getElementById('search-button')?.addEventListener('click', () => {
        searchDialog.showModal()
    })

    const navShortcuts: Record<string, string> = {
        p: '/posts',
        t: '/talks',
        m: '/more',
    }

    window.addEventListener('keydown', (e) => {
        if (isUserTyping()) return

        if (e.key === '/') {
            e.preventDefault()
            searchDialog.showModal()
            return
        }

        if (e.defaultPrevented) return
        const href = navShortcuts[e.key]
        if (href) {
            e.preventDefault()
            window.location.href = href
        }
    })
</script>

<script>
    /* Pin the floating navbar so its chips overlap the intro-widget's
       box-= top border (matches the sidebar-action chip behavior on
       doc pages). Measured on load + resize because the widgets-grid
       uses translate-based centering that's fragile to recompute in
       pure CSS. */
    function alignNavbar() {
        const navbar = document.getElementById('top-navbar')
        const grid = document.getElementById('widgets-grid')
        const introWidget = document.getElementById('intro-widget')
        if (!navbar || !grid) return
        const gridRect = grid.getBoundingClientRect()
        const navHeight = navbar.getBoundingClientRect().height || 20
        const intro = document.getElementById('intro')
        const introRect = intro
            ? intro.getBoundingClientRect()
            : { top: 0, left: 0 }
        // --navbar-top / --navbar-left are interpreted relative to the
        // navbar's offsetParent (#intro), so subtract #intro's own
        // origin to get local coordinates. Slight inline inset (1ch)
        // from the grid edge so the chips don't kiss the corner glyph
        // of the intro-widget's box-= border.
        const left = gridRect.left - introRect.left + 16
        // Sit the navbar so its top edge lands on the intro-widget's
        // box-= top border line, then nudge up 1px so the chip border
        // visually merges with the widget border (matches the sidebar-
        // action chip behavior). The chips' opaque backgrounds will
        // visually cut the border line where they overlay it.
        const targetEl = introWidget ?? grid
        const targetRect = targetEl.getBoundingClientRect()
        const top = targetRect.top - introRect.top - 1
        navbar.style.setProperty('--navbar-left', `${left}px`)
        navbar.style.setProperty('--navbar-top', `${top}px`)
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', alignNavbar)
    } else {
        alignNavbar()
    }
    window.addEventListener('resize', alignNavbar)
</script>
