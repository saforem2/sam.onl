---
/* LastUpdated — renders a "Last Updated" callout whose timestamp is the
   git committer date of the last commit that touched the source page
   (robust to git checkouts rewriting the filesystem mtime), with an
   optional frontmatter override and an mtime fallback. See
   utils/lastModified for the resolution order.

   Usage — pass `path`, the page's source path relative to the `web/`
   workspace (i.e. what you'd see under web/):

       import LastUpdated from '@/components/LastUpdated.astro'
       <LastUpdated path="src/pages/about/index.mdx" />

   Why `path` and NOT `file={import.meta.url}`: at build Astro bundles the
   MDX page, so `import.meta.url` points into web/dist/chunks/… — an
   untracked path git can't date, which silently regressed to the build
   date. An explicit source path resolved against process.cwd() (the
   `web/` workspace at build time) is stable and tracked.

   We do the lookup in this Astro component (not inline in MDX) because
   MDX's acorn parser is fussy about top-level `export const`s referencing
   node builtins, and exported identifiers don't reliably reach inline
   `{…}` expressions depending on the rehype pipeline. */
import { join } from 'node:path'
import {
    getLastModified,
    formatISODate,
    formatISOTime,
} from '@/utils/lastModified'

interface Props {
    /** Source path relative to the web/ workspace, e.g. src/pages/about/index.mdx */
    path: string
    title?: string
    /** Optional explicit override (e.g. frontmatter `date-modified`). */
    date?: string | Date | null
}

const { path, title = '📝 Last Updated', date } = Astro.props

// Resolve against process.cwd() (= the `web/` workspace dir at build time)
// to an absolute source path so the git pathspec is cwd-independent.
const { date: modified } = getLastModified(join(process.cwd(), path), date)
const dateStr = formatISODate(modified)
const timeStr = formatISOTime(modified)
---

<details
    is-="accordion"
    class="callout callout-tip callout-inline"
    data-callout="tip"
    open>
    <summary>{title}</summary>
    <p>
        <strong>Updated:</strong>{' '}
        <code>{dateStr}</code> @ <code>{timeStr}</code>
    </p>
</details>
