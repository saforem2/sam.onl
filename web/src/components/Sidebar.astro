const talkExternalByYear = talkExternalLinks.reduce((map, link) => {
    const group = map.get(link.year) ?? []
    group.push(link)
    map.set(link.year, group)
    return map
}, new Map<string, typeof talkExternalLinks>())

const groupPagesByYear = (pages: CollectionEntry<'docs'>[], slug: string) => {
    const grouped = new Map<string, CollectionEntry<'docs'>[]>()
    const misc: CollectionEntry<'docs'>[] = []

    const addPage = (year: string, page: CollectionEntry<'docs'>) => {
        const group = grouped.get(year) ?? []
        group.push(page)
        grouped.set(year, group)
    }

    for (const page of pages) {
        const year = dateGroupedCategories.has(slug)
            ? getPageYear(page, slug)
            : page.id.split('/')[1]

        if (year && yearPattern.test(year)) {
            addPage(year, page)
        } else {
            misc.push(page)
        }
    }

    for (const [, yearPages] of grouped.entries()) {
        if (dateGroupedCategories.has(slug)) {
            yearPages.sort((a, b) => {
                const dateA = getPageDate(a)?.getTime() ?? 0
                const dateB = getPageDate(b)?.getTime() ?? 0
                if (dateA !== dateB) return dateB - dateA
                return a.id.localeCompare(b.id)
            })
        } else {
            yearPages.sort((a, b) => a.id.localeCompare(b.id))
        }
    }

    const years = Array.from(grouped.keys()).sort((a, b) => b.localeCompare(a))
    return { years, grouped, misc }
}

/** Group pages by their first sub-directory under the category slug. */
const groupPagesBySubdir = (pages: CollectionEntry<'docs'>[]) => {
    const grouped = new Map<string, CollectionEntry<'docs'>[]>()
    const misc: CollectionEntry<'docs'>[] = []

    for (const page of pages) {
        const parts = page.id.split('/')
        // parts[0] is the category slug, parts[1] may be a sub-directory
        if (parts.length > 2 && parts[1]) {
            const subdir = parts[1]
            const group = grouped.get(subdir) ?? []
            group.push(page)
            grouped.set(subdir, group)
        } else {
            misc.push(page)
        }
    }

    // Sort pages within each group alphabetically by title
    for (const [, groupPages] of grouped.entries()) {
        groupPages.sort((a, b) => a.data.title.localeCompare(b.data.title))
    }

    const subdirs = Array.from(grouped.keys()).sort()
    return { subdirs, grouped, misc }
}

const subdirLabels: Record<string, string> = {
    start: 'Start',
    installation: 'Installation',
    components: 'Components',
    plugins: 'Plugins',
    contributing: 'Contributing',
}

const categoryKeybinds: Record<string, string> = {
    landing: '0',
    posts: '1',
    talks: '2',
    projects: '3',
    about: '4',
    ideas: '5',
    more: '6',
    webtui: '7',
    now: '8',
}

const labelWithKey = (slug: string) => {
    const key = categoryKeybinds[slug]
    const label = categoryLabels[slug]
    return key !== undefined ? `[${key}] ${label}` : label
}

const { pathname: urlPath } = Astro.url
---

<nav box-="square" shear-="top" id="sidebar">
    <button
        id="sidebar-toggle"
        type="button"
        size-="small"
        aria-expanded="true"
        aria-controls="sidebar-container"
        aria-label="Collapse left sidebar (zh)">
        &lsaquo;<span class="key-z">z</span>[<span class="key-h">h</span>]
    </button>
    <div id="category-container">
        <div id="category-list">
            {
                categories.map(([slug, pages]) => {
                    if (slug === 'landing') {
                        const landingPage =
                            pages.find(({ id }) => id === 'landing') ?? pages[0]

                        if (!landingPage) {
                            return null
                        }

                        return (
                            <a
                                href={`/${landingPage.id}`}
                                class={
                                    compareUrlPaths(urlPath, landingPage.id)
                                        ? 'sidebar-direct-link active'
                                        : 'sidebar-direct-link'
                                }
                                data-slug={landingPage.id}>
                                {labelWithKey(slug)}
                            </a>
                        )
                    }

                    const categoryIndexPage = pages.find(
                        ({ id }) => id === slug,
                    )
                    const shouldLinkCategory =
                        linkedCategorySlugs.has(slug) &&
                        Boolean(categoryIndexPage)
                    const categoryPages = shouldLinkCategory
                        ? pages.filter(({ id }) => id !== slug)
                        : pages
                    const isCategoryActive = pages.some(({ id }) =>
                        compareUrlPaths(urlPath, id),
                    )

                    if (yearGroupedCategories.has(slug)) {
                        const { years, grouped, misc } = groupPagesByYear(
                            categoryPages,
                            slug,
                        )
                        const mergedYears =
                            slug === 'talks'
                                ? Array.from(
                                      new Set([
                                          ...years,
                                          ...talkExternalByYear.keys(),
                                      ]),
                                  ).sort((a, b) => b.localeCompare(a))
                                : years

                        return (
                            <details open={isCategoryActive}>
                                <summary
                                    class={
                                        shouldLinkCategory &&
                                        compareUrlPaths(urlPath, slug)
                                            ? 'active'
                                            : undefined
                                    }>
                                    {shouldLinkCategory ? (
                                        <a
                                            href={`/${slug}`}
                                            class="sidebar-category-link"
                                            onclick="event.stopPropagation()"
                                            data-slug={slug}>
                                            {labelWithKey(slug)}
                                        </a>
                                    ) : (
                                        labelWithKey(slug)
                                    )}
                                    <span
                                        class="fold-icon"
                                        aria-hidden="true"
                                    />
                                </summary>
                                <ul marker-="tree open">
                                    {mergedYears.map((year) => {
                                        const yearPages =
                                            grouped.get(year) ?? []
                                        const yearExternals =
                                            slug === 'talks'
                                                ? (talkExternalByYear.get(
                                                      year,
                                                  ) ?? [])
                                                : []
                                        const isYearActive = yearPages.some(
                                            ({ id }) =>
                                                compareUrlPaths(urlPath, id),
                                        )

                                        const entries = [
                                            ...yearPages.map((page) => ({
                                                type: 'page',
                                                title: page.data.title,
                                                href: `/${page.id}`,
                                                date: getPageDate(page),
                                                isActive: compareUrlPaths(
                                                    urlPath,
                                                    page.id,
                                                ),
                                            })),
                                            ...yearExternals.map(
                                                (external) => ({
                                                    type: 'external',
                                                    // title: `${external.month}: ${external.title} @ ${external.event}`,
                                                    title: `${external.title}`,
                                                    href: external.href,
                                                    date: new Date(
                                                        `${external.year}-${external.month}-01`,
                                                    ),
                                                    isActive: false,
                                                }),
                                            ),
                                        ].sort((a, b) => {
                                            const dateA =
                                                a.date instanceof Date
                                                    ? a.date.getTime()
                                                    : 0
                                            const dateB =
                                                b.date instanceof Date
                                                    ? b.date.getTime()
                                                    : 0
                                            if (dateA !== dateB)
                                                return dateB - dateA
                                            return a.title.localeCompare(
                                                b.title,
                                            )
                                        })

                                        return (
                                            <details
                                                open={isYearActive}
                                                is-="accordion"
                                                class="sidebar-year">
                                                <summary>
                                                    {year}
                                                    <span
                                                        class="fold-icon"
                                                        aria-hidden="true"
                                                    />
                                                </summary>
                                                <ul marker-="tree open">
                                                    {entries.map((entry) => (
                                                        <li>
                                                            <a
                                                                href={
                                                                    entry.href
                                                                }
                                                                class={
                                                                    entry.isActive
                                                                        ? 'active'
                                                                        : entry.type ===
                                                                            'external'
                                                                          ? 'external'
                                                                          : ''
                                                                }
                                                                data-slug={
                                                                    entry.type ===
                                                                    'page'
                                                                        ? entry.href.replace(
                                                                              /^\//,
                                                                              '',
                                                                          )
                                                                        : undefined
                                                                }
                                                                target={
                                                                    entry.type ===
                                                                    'external'
                                                                        ? '_blank'
                                                                        : undefined
                                                                }
                                                                rel={
                                                                    entry.type ===
                                                                    'external'
                                                                        ? 'noreferrer'
                                                                        : undefined
                                                                }>
                                                                {entry.title}
                                                            </a>
                                                        </li>
                                                    ))}
                                                </ul>
                                            </details>
                                        )
                                    })}
                                    {misc.length > 0 ? (
                                        <details
                                            open={misc.some(({ id }) =>
                                                compareUrlPaths(urlPath, id),
                                            )}
                                            is-="accordion"
                                            class="sidebar-year">
                                            <summary>
                                                Other
                                                <span
                                                    class="fold-icon"
                                                    aria-hidden="true"
                                                />
                                            </summary>
                                            <ul marker-="tree open">
                                                {misc.map(
                                                    ({
                                                        id,
                                                        data: { title },
                                                    }) => (
                                                        <li>
                                                            <a
                                                                href={`/${id}`}
                                                                class={
                                                                    compareUrlPaths(
                                                                        urlPath,
                                                                        id,
                                                                    )
                                                                        ? 'active'
                                                                        : ''
                                                                }
                                                                data-slug={id}>
                                                                {title}
                                                            </a>
                                                        </li>
                                                    ),
                                                )}
                                            </ul>
                                        </details>
                                    ) : null}
                                </ul>
                            </details>
                        )
                    }

                    if (shouldLinkCategory && categoryPages.length === 0) {
                        return (
                            <a
                                href={`/${slug}`}
                                class={
                                    isCategoryActive
                                        ? 'sidebar-direct-link active'
                                        : 'sidebar-direct-link'
                                }
                                data-slug={slug}>
                                {labelWithKey(slug)}
                            </a>
                        )
                    }

                    // Single-page category → render as direct link
                    if (categoryPages.length === 1) {
                        const page = categoryPages[0]
                        return (
                            <a
                                href={`/${page.id}`}
                                class={
                                    isCategoryActive
                                        ? 'sidebar-direct-link active'
                                        : 'sidebar-direct-link'
                                }
                                data-slug={page.id}>
                                {labelWithKey(slug)}
                            </a>
                        )
                    }

                    // Check if this category has sub-directory structure
                    const {
                        subdirs,
                        grouped: subdirGrouped,
                        misc: subdirMisc,
                    } = groupPagesBySubdir(categoryPages)
                    const hasSubdirs = subdirs.length > 0

                    return (
                        <details open={isCategoryActive}>
                            <summary
                                class={
                                    shouldLinkCategory &&
                                    compareUrlPaths(urlPath, slug)
                                        ? 'active'
                                        : undefined
                                }>
                                {shouldLinkCategory ? (
                                    <a
                                        href={`/${slug}`}
                                        class="sidebar-category-link"
                                        onclick="event.stopPropagation()"
                                        data-slug={slug}>
                                        {labelWithKey(slug)}
                                    </a>
                                ) : (
                                    labelWithKey(slug)
                                )}
                                <span class="fold-icon" aria-hidden="true" />
                            </summary>
                            <ul marker-="tree open">
                                {hasSubdirs ? (
                                    <>
                                        {subdirs.map((subdir) => {
                                            const subdirPages =
                                                subdirGrouped.get(subdir) ?? []
                                            const isSubdirActive =
                                                subdirPages.some(({ id }) =>
                                                    compareUrlPaths(
                                                        urlPath,
                                                        id,
                                                    ),
                                                )
                                            return (
                                                <details
                                                    open={isSubdirActive}
                                                    is-="accordion"
                                                    class="sidebar-year">
                                                    <summary>
                                                        {subdirLabels[subdir] ??
                                                            subdir}
                                                        <span
                                                            class="fold-icon"
                                                            aria-hidden="true"
                                                        />
                                                    </summary>
                                                    <ul marker-="tree open">
                                                        {subdirPages.map(
                                                            ({
                                                                id,
                                                                data: { title },
                                                            }) => (
                                                                <li>
                                                                    <a
                                                                        href={`/${id}`}
                                                                        class={
                                                                            compareUrlPaths(
                                                                                urlPath,
                                                                                id,
                                                                            )
                                                                                ? 'active'
                                                                                : ''
                                                                        }
                                                                        data-slug={
                                                                            id
                                                                        }>
                                                                        {title}
                                                                    </a>
                                                                </li>
                                                            ),
                                                        )}
                                                    </ul>
                                                </details>
                                            )
                                        })}
                                        {subdirMisc.length > 0 &&
                                            subdirMisc.map(
                                                ({ id, data: { title } }) => (
                                                    <li>
                                                        <a
                                                            href={`/${id}`}
                                                            class={
                                                                compareUrlPaths(
                                                                    urlPath,
                                                                    id,
                                                                )
                                                                    ? 'active'
                                                                    : ''
                                                            }
                                                            data-slug={id}>
                                                            {title}
                                                        </a>
                                                    </li>
                                                ),
                                            )}
                                    </>
                                ) : (
                                    categoryPages.map(
                                        ({ id, data: { title } }) => (
                                            <li>
                                                <a
                                                    href={`/${id}`}
                                                    class={
                                                        compareUrlPaths(
                                                            urlPath,
                                                            id,
                                                        )
                                                            ? 'active'
                                                            : ''
                                                    }
                                                    data-slug={id}>
                                                    {title}
                                                </a>
                                            </li>
                                        ),
                                    )
                                )}
                            </ul>
                        </details>
                    )
                })
            }
        </div>
    </div>
    <div id="sidebar-vim-nav-container">
        <VimNavigation showHL />
    </div>
</nav>

<style>
    #sidebar-vim-nav-container {
        padding-left: 1ch;
        padding-right: 2ch;
        padding-top: 1lh;
        padding-bottom: 1lh;
        display: flex;
        flex-direction: row;
    }
    #sidebar {
        position: relative;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        flex-grow: 1;
        padding-inline: 1ch;
        /* margin-inline-start: 1ch; */
        /* line-height: 1.5; */
        /* line-height: var(--line-height, 1.227); */

        #sidebar-toggle {
            position: absolute;
            z-index: 3;
        }

        &:focus-within {
            --box-border-color: var(--focus-region-border);
        }

        :is(a[href], summary, button:not([disabled])) {
            position: relative;
            outline: none;
            border: 0.3ch solid rgba(0, 0, 0, 0);
        }

        summary > a.sidebar-category-link {
            border: none;
        }

        :is(a[href], summary, button:not([disabled]))::after {
            content: '';
            position: absolute;
            inset-inline-start: -1ch;
            inset-block-start: 0;
            color: transparent;
            width: 1ch;
            pointer-events: none;
        }

        :is(a[href], summary, button:not([disabled])) {
            transition:
                background-color 100ms linear,
                color 100ms linear,
                box-shadow 100ms linear;
        }

        :is(a[href], summary, button:not([disabled])):focus-visible,
        :is(
                a[href],
                summary,
                button:not([disabled])
            )[data-vim-focused='true']:focus {
            background-color: var(--focus-bg-strong);
            color: var(--focus-fg);
            /* border-left: 1px solid var(--accent); */
            text-decoration: none;
            /* .sidebar-category-link:hover { */
            border: 0.3ch solid rgba(0, 0, 0, 0) !important;
            /* } */
            /* box-shadow: */
            /*     inset var(--focus-rail-size) 0 0 0 var(--focus-marker), */
            /*     inset 0 0 0 1px var(--focus-border); */
            /* outline: 1px solid var(--focus-border); */
            /* background-color: var(--focus-bg-strong); */
            /* color: var(--focus-fg); */
            /* box-shadow: */
            /*     inset var(--focus-rail-size) 0 0 0 var(--focus-marker), */
            /*     inset 0 0 0 1px var(--focus-border); */
            /* outline: none; */
            /* text-decoration: none; */
        }

        :is(a[href], summary, button:not([disabled])):focus-visible::after,
        :is(
                a[href],
                summary,
                button:not([disabled])
            )[data-vim-focused='true']:focus::after {
            color: var(--focus-marker);
        }

        :is(a[href], summary, button:not([disabled])):hover {
            background-color: var(--focus-hover-bg);
        }

        #category-container {
            position: relative;
            flex-grow: 1;
            margin-top: 1lh;
        }

        #category-list {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            gap: 0lh;
            overflow-y: auto;
            padding-block-start: 1ch;
            /* padding-inline-start: 1ch; */
            /* margin-inline-start: 1ch; */
            /* margin-inline: 1ch; */
        }
    }

    details > summary > a.sidebar-category-link {
        color: inherit;
        text-decoration: none;
    }

    details > summary.active {
        color: var(--accent);
        background-color: oklch(
            from var(--background-active, var(--background2, #838383))
                calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
    }

    li {
        padding-inline-start: 0ch;
    }

    ul > li > a[href] {
        color: var(--foreground2);
        border: 0.33ch solid rgba(0, 0, 0, 0) !important;
    }
    /* #sidebar ul > li > a { */
    /*     border-left: 1pt solid var(--background2); */
    /*     padding-inline-start: 1ch; */
    /*     margin-inline-start: calc(-2ch); */
    /*     margin-block: 0ch; */
    /*     border: 1ch solid var(--background0); */
    /* } */
    /* .sidebar-category-link a { */
    /*     border: 1ch solid var(--background0); */
    /* } */
    /* .sidebar-direct-link a { */
    /*     border: 1ch solid var(--background0); */
    /* } */

    ul ul > li > a[href] {
        color: var(--foreground2);
        text-decoration: none;
        outline: none;
        display: block;
        min-width: 0;

        &.active {
            color: var(--accent);
            background-color: oklch(
                from
                    var(
                        --accent,
                        var(--background-active, var(--background2, #838383))
                    )
                    calc(l * var(--oklch-scale, 0.85)) c h / 0.1
            );
        }
    }

    ul > li > a.external {
        color: var(--foreground2);
        font-style: italic;
    }

    #sidebar ul[marker-~='tree'] > li {
        /* display: grid; */
