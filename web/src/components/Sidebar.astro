const talkExternalByYear = talkExternalLinks.reduce((map, link) => {
    const group = map.get(link.year) ?? []
    group.push(link)
    map.set(link.year, group)
    return map
}, new Map<string, typeof talkExternalLinks>())

const groupPagesByYear = (pages: CollectionEntry<'docs'>[], slug: string) => {
    const grouped = new Map<string, CollectionEntry<'docs'>[]>()
    const misc: CollectionEntry<'docs'>[] = []

    const addPage = (year: string, page: CollectionEntry<'docs'>) => {
        const group = grouped.get(year) ?? []
        group.push(page)
        grouped.set(year, group)
    }

    for (const page of pages) {
        const year = dateGroupedCategories.has(slug)
            ? getPageYear(page, slug)
            : page.id.split('/')[1]

        if (year && yearPattern.test(year)) {
            addPage(year, page)
        } else {
            misc.push(page)
        }
    }

    for (const [, yearPages] of grouped.entries()) {
        if (dateGroupedCategories.has(slug)) {
            yearPages.sort((a, b) => {
                const dateA = getPageDate(a)?.getTime() ?? 0
                const dateB = getPageDate(b)?.getTime() ?? 0
                if (dateA !== dateB) return dateB - dateA
                return a.id.localeCompare(b.id)
            })
        } else {
            yearPages.sort((a, b) => a.id.localeCompare(b.id))
        }
    }

    const years = Array.from(grouped.keys()).sort((a, b) => b.localeCompare(a))
    return { years, grouped, misc }
}

const { pathname: urlPath } = Astro.url
---

<nav box-="square" shear-="top" id="sidebar">
    <button
        id="sidebar-toggle"
        type="button"
        size-="small"
        variant-="background1"
        aria-expanded="true"
        aria-controls="sidebar-container"
        aria-label="Collapse left sidebar ([ key)">
        <code>&lt;[&gt;</code>
    </button>
    <div id="category-container">
        <div id="category-list">
            {
                categories.map(([slug, pages]) => {
                    if (slug === 'landing') {
                        const landingPage =
                            pages.find(({ id }) => id === 'landing') ?? pages[0]

                        if (!landingPage) {
                            return null
                        }

                        return (
                            <a
                                href={`/${landingPage.id}`}
                                class={
                                    compareUrlPaths(urlPath, landingPage.id)
                                        ? 'sidebar-direct-link active'
                                        : 'sidebar-direct-link'
                                }
                                data-slug={landingPage.id}>
                                {categoryLabels[slug]}
                            </a>
                        )
                    }

                    const categoryIndexPage = pages.find(
                        ({ id }) => id === slug,
                    )
                    const shouldLinkCategory =
                        linkedCategorySlugs.has(slug) &&
                        Boolean(categoryIndexPage)
                    const categoryPages = shouldLinkCategory
                        ? pages.filter(({ id }) => id !== slug)
                        : pages
                    const isCategoryActive = pages.some(({ id }) =>
                        compareUrlPaths(urlPath, id),
                    )

                    if (yearGroupedCategories.has(slug)) {
                        const { years, grouped, misc } = groupPagesByYear(
                            categoryPages,
                            slug,
                        )
                        const mergedYears =
                            slug === 'talks'
                                ? Array.from(
                                      new Set([
                                          ...years,
                                          ...talkExternalByYear.keys(),
                                      ]),
                                  ).sort((a, b) => b.localeCompare(a))
                                : years

                        return (
                            <details open={isCategoryActive}>
                                <summary>
                                    {shouldLinkCategory ? (
                                        <a
                                            href={`/${slug}`}
                                            class="sidebar-category-link"
                                            onclick="event.stopPropagation()"
                                            data-slug={slug}>
                                            {categoryLabels[slug]}
                                        </a>
                                    ) : (
                                        categoryLabels[slug]
                                    )}
                                </summary>
                                <ul marker-="tree open">
                                    {mergedYears.map((year) => {
                                        const yearPages =
                                            grouped.get(year) ?? []
                                        const yearExternals =
                                            slug === 'talks'
                                                ? (talkExternalByYear.get(
                                                      year,
                                                  ) ?? [])
                                                : []
                                        const isYearActive = yearPages.some(
                                            ({ id }) =>
                                                compareUrlPaths(urlPath, id),
                                        )

                                        const entries = [
                                            ...yearPages.map((page) => ({
                                                type: 'page',
                                                title: page.data.title,
                                                href: `/${page.id}`,
                                                date: getPageDate(page),
                                                isActive: compareUrlPaths(
                                                    urlPath,
                                                    page.id,
                                                ),
                                            })),
                                            ...yearExternals.map(
                                                (external) => ({
                                                    type: 'external',
                                                    // title: `${external.month}: ${external.title} @ ${external.event}`,
                                                    title: `${external.title}`,
                                                    href: external.href,
                                                    date: new Date(
                                                        `${external.year}-${external.month}-01`,
                                                    ),
                                                    isActive: false,
                                                }),
                                            ),
                                        ].sort((a, b) => {
                                            const dateA =
                                                a.date instanceof Date
                                                    ? a.date.getTime()
                                                    : 0
                                            const dateB =
                                                b.date instanceof Date
                                                    ? b.date.getTime()
                                                    : 0
                                            if (dateA !== dateB)
                                                return dateB - dateA
                                            return a.title.localeCompare(
                                                b.title,
                                            )
                                        })

                                        return (
                                            <details
                                                open={isYearActive}
                                                is-="accordion"
                                                class="sidebar-year">
                                                <summary>{year}</summary>
                                                <ul marker-="tree open">
                                                    {entries.map((entry) => (
                                                        <li>
                                                            <a
                                                                href={
                                                                    entry.href
                                                                }
                                                                class={
                                                                    entry.isActive
                                                                        ? 'active'
                                                                        : entry.type ===
                                                                            'external'
                                                                          ? 'external'
                                                                          : ''
                                                                }
                                                                data-slug={
                                                                    entry.type ===
                                                                    'page'
                                                                        ? entry.href.replace(
                                                                              /^\//,
                                                                              '',
                                                                          )
                                                                        : undefined
                                                                }
                                                                target={
                                                                    entry.type ===
                                                                    'external'
                                                                        ? '_blank'
                                                                        : undefined
                                                                }
                                                                rel={
                                                                    entry.type ===
                                                                    'external'
                                                                        ? 'noreferrer'
                                                                        : undefined
                                                                }>
                                                                {entry.title}
                                                            </a>
                                                        </li>
                                                    ))}
                                                </ul>
                                            </details>
                                        )
                                    })}
                                    {misc.length > 0 ? (
                                        <details
                                            open={misc.some(({ id }) =>
                                                compareUrlPaths(urlPath, id),
                                            )}
                                            is-="accordion"
                                            class="sidebar-year">
                                            <summary>Other</summary>
                                            <ul marker-="tree open">
                                                {misc.map(
                                                    ({
                                                        id,
                                                        data: { title },
                                                    }) => (
                                                        <li>
                                                            <a
                                                                href={`/${id}`}
                                                                class={
                                                                    compareUrlPaths(
                                                                        urlPath,
                                                                        id,
                                                                    )
                                                                        ? 'active'
                                                                        : ''
                                                                }
                                                                data-slug={id}>
                                                                {title}
                                                            </a>
                                                        </li>
                                                    ),
                                                )}
                                            </ul>
                                        </details>
                                    ) : null}
                                </ul>
                            </details>
                        )
                    }

                    if (shouldLinkCategory && categoryPages.length === 0) {
                        return (
                            <a
                                href={`/${slug}`}
                                class={
                                    isCategoryActive
                                        ? 'sidebar-direct-link active'
                                        : 'sidebar-direct-link'
                                }
                                data-slug={slug}>
                                {categoryLabels[slug]}
                            </a>
                        )
                    }

                    return (
                        <details open={isCategoryActive}>
                            <summary>
                                {shouldLinkCategory ? (
                                    <a
                                        href={`/${slug}`}
                                        class="sidebar-category-link"
                                        onclick="event.stopPropagation()"
                                        data-slug={slug}>
                                        {categoryLabels[slug]}
                                    </a>
                                ) : (
                                    categoryLabels[slug]
                                )}
                            </summary>
                            <ul marker-="tree open">
                                {categoryPages.map(
                                    ({ id, data: { title } }) => (
                                        <li>
                                            <a
                                                href={`/${id}`}
                                                class={
                                                    compareUrlPaths(urlPath, id)
                                                        ? 'active'
                                                        : ''
                                                }
                                                data-slug={id}>
                                                {title}
                                            </a>
                                        </li>
                                    ),
                                )}
                            </ul>
                        </details>
                    )
                })
            }
        </div>
    </div>
    <div id="sidebar-vim-nav-container">
        <VimNavigation showHL />
    </div>
</nav>

<style>
    #sidebar-vim-nav-container {
        padding-left: 1ch;
        padding-right: 2ch;
        padding-top: 1lh;
        padding-bottom: 1lh;
        display: flex;
        flex-direction: row;
    }
    #sidebar {
        position: relative;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        flex-grow: 1;
        line-height: 1.5;
        /* line-height: var(--line-height, 1.227); */

        #sidebar-toggle {
            position: absolute;
            z-index: 3;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;

            code {
                background-color: transparent;
            }
        }

        &:focus-within {
            --box-border-color: var(--focus-region-border);
        }

        :is(a[href], summary, button:not([disabled])) {
            position: relative;
            outline: none;
        }

        :is(a[href], summary, button:not([disabled]))::after {
            content: '';
            position: absolute;
            inset-inline-start: -1ch;
            inset-block-start: 0;
            color: transparent;
            width: 1ch;
            pointer-events: none;
        }

        :is(a[href], summary, button:not([disabled])) {
            transition:
                background-color 100ms linear,
                color 100ms linear,
                box-shadow 100ms linear;
        }

        :is(a[href], summary, button:not([disabled])):focus-visible,
        :is(
                a[href],
                summary,
                button:not([disabled])
            )[data-vim-focused='true']:focus {
            background-color: var(--focus-bg-strong);
            color: var(--focus-fg);
            border-left: 1px solid var(--accent);
            text-decoration: none;
            /* box-shadow: */
            /*     inset var(--focus-rail-size) 0 0 0 var(--focus-marker), */
            /*     inset 0 0 0 1px var(--focus-border); */
            /* outline: 1px solid var(--focus-border); */
            /* background-color: var(--focus-bg-strong); */
            /* color: var(--focus-fg); */
            /* box-shadow: */
            /*     inset var(--focus-rail-size) 0 0 0 var(--focus-marker), */
            /*     inset 0 0 0 1px var(--focus-border); */
            /* outline: none; */
            /* text-decoration: none; */
        }

        :is(a[href], summary, button:not([disabled])):focus-visible::after,
        :is(
                a[href],
                summary,
                button:not([disabled])
            )[data-vim-focused='true']:focus::after {
            color: var(--focus-marker);
        }

        :is(a[href], summary, button:not([disabled])):hover {
            background-color: var(--focus-hover-bg);
        }

        #category-container {
            position: relative;
            flex-grow: 1;
            margin-top: 2lh;
        }

        #category-list {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            gap: 0lh;
            overflow-y: auto;
            /* margin-inline: 1ch; */
        }
    }

    details > summary > a.sidebar-category-link {
        color: inherit;
        text-decoration: none;
    }

    li {
        padding-inline-start: 0ch;
    }

    ul > li > a[href] {
        color: var(--foreground2);
        text-decoration: none;
        outline: none;
        display: block;
        min-width: 0;

        &.active {
            background-color: oklch(
                from var(--background-active, var(--background2, #838383))
                    calc(l * var(--oklch-scale, 0.85)) c h / 0.1
            );
        }
    }

    ul > li > a.external {
        color: var(--foreground2);
        font-style: italic;
    }

    #sidebar ul[marker-~='tree'] > li {
        display: grid;
        grid-template-columns: 2ch minmax(0, 1fr);
        align-items: start;
    }

    #sidebar ul[marker-~='tree'] > li::before {
        grid-column: 1;
        content: '- ';
        color: var(--foreground2);
    }

    #sidebar ul[marker-~='tree'] > li > a {
        grid-column: 2;
    }

    ul > details {
        display: block;
        padding-left: 0;
    }

    ul > details > summary {
        color: var(--foreground2);
        font-weight: var(--font-weight-normal);
        display: list-item;
        /* margin-block-start: 1ch; */
        color: var(--foreground1);
        background-color: var(--background0);
    }
    ul > details > summary::marker {
        content: '\ \ ';
        /* margin-inline-start: -1ch; */

        &[open] {
            summary {
                &::marker {
                    content: '\ \ ';
                }
            }
        }
    }

    #category-list > a.sidebar-direct-link {
        color: var(--foreground1);
        text-decoration: none;
        margin-inline-start: 1ch;
        outline: none;
        display: block;
        /* margin-inline-start: 1ch; */
        /* margin-block-end: 1lh; */
        &:hover {
            background-color: var(--background1);
        }

        &.active {
            background-color: oklch(
                from var(--background-active, var(--background2, #838383))
                    calc(l * var(--oklch-scale, 0.85)) c h / 0.1
            );
        }
    }

    #category-list > a.sidebar-direct-link::before {
        content: ' ';
        margin-inline: 1ch;
    }

    ul > details > summary {
        padding-inline-start: 0ch;
    }

    /* ul > details > summary::before { */
    /*     content: '├ '; */
    /* } */

    /* ul > details:last-of-type > summary::before { */
    /*     content: '└ '; */
    /* } */

    ul ul {
        padding-left: 2ch;
        margin: 0;
    }

    details.sidebar-year {
        margin: 0;
    }

    details {
        /* margin-block-end: 1lh; */
        summary {
            font-weight: 500;
            background-color: none;
            color: var(--foreground1);
            &::marker {
                color: var(--foreground2);
                content: '>';
            }

            &:hover {
                background-color: var(--background1);
            }
        }

        &[open] {
            summary {
                &::marker {
                    content: 'v';
                }
            }
        }
    }

    details[open] a.hidden,
    details.hidden,
    .hidden {
        display: none;
    }

    ul > details {
        /* margin-block-end: 1ch; */
        padding-inline-start: 1ch;
        summary {
            font-weight: var(--font-weight-bold);
            &::marker {
                color: var(--foreground2);
                content: '\ ';
            }

            &:hover {
                background-color: var(--background1);
            }
        }

        &[open] {
            summary {
                &::marker {
                    content: '\ ';
                }
            }
        }
    }
</style>

<script>
    import { applyVimNavigation } from '@/utils/vim'

    const sidebar = document.getElementById('sidebar')
    let lastInteractionWasPointer = false

    const revealFocusedElement = (element: HTMLElement) => {
        let parent = element.parentElement

        while (parent) {
            if (parent instanceof HTMLDetailsElement) {
                parent.open = true
            }

            if (parent.id === 'sidebar') break
            parent = parent.parentElement
        }
    }

    if (sidebar) {
        sidebar.addEventListener('pointerdown', () => {
            lastInteractionWasPointer = true
        })

        sidebar.addEventListener('keydown', () => {
            lastInteractionWasPointer = false
        })

        applyVimNavigation(
            sidebar,
            '#category-list > a:not(.hidden), details:not(.hidden)[open] a:not(.hidden), details:not(.hidden) summary',
            (element) => {
                if (lastInteractionWasPointer) {
                    return
                }

                if (element.tagName === 'SUMMARY') {
                    return
                }

                revealFocusedElement(element)
            },
        )
    }
</script>
