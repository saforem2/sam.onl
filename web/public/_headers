# Cloudflare Pages header rules. Mirrors the [[headers]] block from
# the old netlify.toml. CF Pages reads this file from the publish
# root (web/dist) at deploy time; web/public/ is copied verbatim
# into dist by Astro's build.
#
# https://developers.cloudflare.com/pages/configuration/headers/

# Self-hosted font binaries (Iosevka, Nerd Font) are content-addressable
# by path; pin them as immutable for a year so users never re-download.
# Scoped to *.woff2 only so the sibling .css files (iosevka.css /
# nerd.css) stay invalidatable if we ever change @font-face decls.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Astro's build-emitted assets are content-hashed in the filename
# (e.g. global.CXrEEoPr.css), so their contents can never change under a
# given URL. Pin the whole /_astro/ dir immutable for a year — 17 MB of
# JS/CSS/SVG/KaTeX fonts that otherwise fall back to CF's default (short)
# cache and get revalidated on every repeat visit.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
